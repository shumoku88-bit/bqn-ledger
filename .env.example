# Local environment variable overrides (template only).
# Copy this file to .env and adjust values. Never commit the actual .env.
LEDGER_DATA_DIR=/path/to/ledger-data/data
REPORT_MANIFEST_CONFIG=/path/to/ledger-data/data/report_manifests.tsv

# Local terminal UI only; never put these keys in ledger data/config.tsv.
BL_UI_MODE=rich
BL_THEME=nord
BL_SELECTOR=auto
BL_FZF_PREVIEW_WINDOW=right:75%
