# Local environment variable overrides (template only).
# Copy this file to .env and adjust values. Never commit the actual .env.
LEDGER_DATA_DIR=/path/to/canonical-household
# Optional. Omit for a single-domain Household; required when multiple domains exist.
REPORT_DOMAIN=JPY

# Local terminal UI only; never put these keys in Household policy files.
BL_UI_MODE=rich
BL_THEME=nord
BL_SELECTOR=auto
BL_FZF_PREVIEW_WINDOW=right:75%
