#!/usr/bin/env bash
# Strict source-facing destination readiness command. Not a report section.
set -euo pipefail
if [[ $# -ne 7 ]]; then
  echo 'Usage: tools/ledger-check BASE JOURNAL PLAN BUDGET CYCLE ISSUES DAILY_SCOPE' >&2
  exit 2
fi
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
base=$1
shift
[[ $base == /* ]] || base="$PWD/$base"
for name in "$@"; do
  [[ $name != */* && $name != *\\* && ( $name == *.tsv || $name == *.journal ) ]] \
    || { printf 'ERROR\tsource_basename_invalid\tinvalid source basename: %s\n' "$name" >&2; exit 1; }
done
for name in config.tsv accounts.tsv "$@"; do
  [[ -f $base/$name && -r $base/$name ]] \
    || { printf 'ERROR\tsource_unreadable\trequired source is not readable: %s\n' "$name" >&2; exit 1; }
done
cd "$root"
exec bqn src/application/ledger_check_cli.bqn "$base" "$@"
