#!/usr/bin/env bash
# Strict source-facing readiness command for the canonical Household root.
set -euo pipefail
if [[ $# -ne 1 ]]; then
  echo 'Usage: tools/ledger-check BASE' >&2
  exit 2
fi
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
base=$1
[[ $base == /* ]] || base="$PWD/$base"

for name in accounts.journal actual.journal plan.journal entitlement.journal envelope.toml household.toml report.toml issues.tsv; do
  [[ -f $base/$name && -r $base/$name ]] \
    || { printf 'ERROR\tsource_unreadable\trequired canonical source is not readable: %s\n' "$name" >&2; exit 1; }
done
cd "$root"
exec bqn src/application/ledger_check_cli.bqn "$base"
