#!/usr/bin/env bash
# Parallel proof for the final exact ledger_* query contract.
set -euo pipefail
usage() {
  cat >&2 <<'USAGE'
Usage: tools/query-destination BASE COMPACT_MANIFEST LEDGER_KEY
       tools/query-destination BASE COMPACT_MANIFEST --list
       tools/query-destination BASE COMPACT_MANIFEST --keys

LEDGER_KEY lookup is exact and prints every matching value in summary order.
No src_next key translation, regex lookup, or human-heading parsing is provided.
USAGE
}
[[ $# -eq 3 ]] || { usage; exit 2; }
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
base=$1
manifest=$2
request=$3
case "$request" in
  --list|--keys) ;;
  --*) usage; exit 2 ;;
  *)
    [[ $request =~ ^ledger_[a-z0-9_]+$ ]] \
      || { printf 'ERROR: unsupported query key: %s\n' "$request" >&2; exit 1; }
    ;;
esac
tmp=$(mktemp "${TMPDIR:-/tmp}/bqn-ledger-query.XXXXXX")
trap 'rm -f "$tmp"' EXIT
"$root/tools/report-summary" "$base" "$manifest" >"$tmp"
case "$request" in
  --list)
    awk -F': ' '$1 ~ /^ledger_[a-z0-9_]+$/ {print}' "$tmp"
    ;;
  --keys)
    awk -F': ' '$1 ~ /^ledger_[a-z0-9_]+$/ && !seen[$1]++ {print $1}' "$tmp"
    ;;
  *)
    awk -F': ' -v key="$request" '$1 == key {print substr($0, length($1)+3); found=1} END {exit !found}' "$tmp" \
      || { printf 'ERROR: key not found: %s\n' "$request" >&2; exit 1; }
    ;;
esac
