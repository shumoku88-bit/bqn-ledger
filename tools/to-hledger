#!/usr/bin/env python3
"""Export the canonical Journal surface for hledger without reviving legacy TSV."""

from __future__ import annotations

import os
from pathlib import Path
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
CANONICAL = ("accounts.journal", "actual.journal", "plan.journal")


def base_dir() -> Path:
    if len(sys.argv) > 2:
        raise SystemExit("Usage: tools/to-hledger [canonical-household-root]")
    if len(sys.argv) == 2:
        return Path(sys.argv[1]).expanduser().resolve()
    configured = os.environ.get("LEDGER_DATA_DIR")
    return Path(configured).expanduser().resolve() if configured else (ROOT / "data").resolve()


def output_dir() -> Path:
    configured = os.environ.get("HLEDGER_DATA_DIR")
    return Path(configured).expanduser().resolve() if configured else (ROOT.parent / "hledger-data").resolve()


def main() -> None:
    base = base_dir()
    out = output_dir()
    subprocess.run([str(ROOT / "tools/ledger-check"), str(base)], cwd=ROOT, check=True,
                   stdout=subprocess.DEVNULL)
    out.mkdir(parents=True, exist_ok=True)

    for name in CANONICAL:
        source = base / name
        if not source.is_file() or source.is_symlink():
            raise SystemExit(f"Canonical source is missing or unsafe: {source}")
        shutil.copyfile(source, out / name)
        print(f"Created {out / name}")

    master = out / "hledger.journal"
    master.write_text(
        "; Exported from the canonical Household Journal surface.\n"
        "; Re-run tools/to-hledger; do not edit this export directly.\n\n"
        "include actual.journal\n"
        "; include plan.journal  ; enable only when future Plans are wanted\n",
        encoding="utf-8",
    )
    print(f"Created {master}")


if __name__ == "__main__":
    main()
