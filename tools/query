#!/usr/bin/env bash
# Exact ledger_* query contract over the canonical compact Report summary.
set -euo pipefail
usage() {
  cat >&2 <<'USAGE'
Usage: tools/query BASE DOMAIN LEDGER_KEY [LATEST]
       tools/query BASE DOMAIN --list [LATEST]
       tools/query BASE DOMAIN --keys [LATEST]

LEDGER_KEY lookup is exact and prints every matching value in summary order.
No retired-key translation, regex lookup, human-heading parsing, or request
manifest input is provided.
USAGE
}
[[ $# -ge 3 && $# -le 4 ]] || { usage; exit 2; }
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
base=$1
domain=$2
request=$3
latest=${4:-}
case "$request" in
  --list|--keys) ;;
  --*) usage; exit 2 ;;
  *)
    [[ $request =~ ^ledger_[a-z0-9_]+$ ]] \
      || { printf 'ERROR: unsupported query key: %s\n' "$request" >&2; exit 1; }
    ;;
esac
tmp=$(mktemp "${TMPDIR:-/tmp}/bqn-ledger-query.XXXXXX")
trap 'rm -f "$tmp"' EXIT
summary_args=("$base" "$domain")
[[ -z $latest ]] || summary_args+=("$latest")
"$root/tools/report-summary" "${summary_args[@]}" >"$tmp"
case "$request" in
  --list)
    awk -F': ' '$1 ~ /^ledger_[a-z0-9_]+$/ {print}' "$tmp"
    ;;
  --keys)
    awk -F': ' '$1 ~ /^ledger_[a-z0-9_]+$/ && !seen[$1]++ {print $1}' "$tmp"
    ;;
  *)
    awk -F': ' -v key="$request" '$1 == key {print substr($0, length($1)+3); found=1} END {exit !found}' "$tmp" \
      || { printf 'ERROR: key not found: %s\n' "$request" >&2; exit 1; }
    ;;
esac
