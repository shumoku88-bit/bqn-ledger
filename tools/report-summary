#!/usr/bin/env bash
# Canonical compact summary from report.toml plus canonical Household evidence.
set -euo pipefail
usage() {
  cat >&2 <<'USAGE'
Usage: tools/report-summary BASE DOMAIN [LATEST]

DOMAIN is the explicit accounting domain for this result. LATEST is optional and
is mainly useful for deterministic tests; normal operation uses the local day.
USAGE
}
[[ $# -ge 2 && $# -le 3 ]] || { usage; exit 2; }
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
domain=$2
latest=${3:-}
[[ $base == /* ]] || base="$caller_pwd/$base"
[[ -d $base ]] || { printf 'ERROR\tsummary_base_unreadable\tbase directory is not readable\n' >&2; exit 1; }
args=("$base" "$domain" compact)
[[ -z $latest ]] || args+=("$latest")
exec "$root/tools/report-all" "${args[@]}"
