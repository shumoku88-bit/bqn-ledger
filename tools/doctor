#!/usr/bin/env bash
set -euo pipefail

# tools/doctor — dependency health check and SBOM for bqn-ledger

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/tools/lib/system-defaults.sh"

red=''
green=''
yellow=''
reset=''
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  red='\033[31m' green='\033[32m' yellow='\033[33m' reset='\033[0m'
fi

pass()  { printf "  ${green}PASS${reset} %s\n" "$*"; }
warn()  { printf "  ${yellow}WARN${reset} %s\n" "$*"; }
fail()  { printf "  ${red}FAIL${reset} %s\n" "$*"; all_ok=0; }
info()  { printf "  %s\n" "$*"; }

all_ok=1
failures=0

echo "=== bqn-ledger doctor ==="
echo ""

# ── Required dependencies ──
echo "Required:"

# CBQN
if command -v bqn >/dev/null 2>&1; then
  ver=$(bqn --version 2>&1 | head -1)
  pass "CBQN: $ver"
else
  fail "CBQN not found (install: https://github.com/dzaima/CBQN)"
  failures=$((failures + 1))
fi
echo ""

# ── Optional dependencies ──
echo "Optional:"

for tool in fzf gum rg; do
  if command -v "$tool" >/dev/null 2>&1; then
    pass "$tool: $(command -v "$tool")"
  else
    warn "$tool: not installed"
  fi
done

echo ""

# ── Canonical Household root ──
echo "Data:"
base_source="config/system_defaults.tsv DEFAULT_BASE_DIR"
if [[ -n "${LEDGER_DATA_DIR:-}" ]]; then
  base_source="LEDGER_DATA_DIR"
fi
base_dir="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
data_ok=1
info "base dir ($base_source): $base_dir"

if [[ -d "$base_dir" ]]; then
  mapfile -t missing_required < <(canonical_report_base_missing_required "$base_dir")
  if [[ ${#missing_required[@]} -eq 0 ]]; then
    pass "canonical Household root files present: 8"
    if "$ROOT_DIR/tools/ledger-check" "$base_dir" ignored ignored ignored ignored ignored ignored >/dev/null 2>&1 \
      && bqn src/application/report_presentation_cli.bqn "$base_dir" >/dev/null 2>&1; then
      pass "canonical Household source admission succeeded"
    else
      fail "canonical Household source admission failed"
      failures=$((failures + 1)); data_ok=0
    fi
  else
    fail "missing canonical Household file(s): ${missing_required[*]}"
    failures=$((failures + 1))
    data_ok=0
  fi
else
  fail "base dir not found: $base_dir"
  failures=$((failures + 1))
  data_ok=0
fi

if [[ "$data_ok" -eq 0 ]]; then
  warn "set LEDGER_DATA_DIR to a canonical Household root"
fi

echo ""

# ── Destination catalog smoke test ──
echo "Destination:"
if metadata=$(tools/report-section-metadata --format tsv 2>&1) \
    && [[ $(printf '%s\n' "$metadata" | wc -l | tr -d ' ') -eq 13 ]]; then
  pass "report catalog metadata exposes twelve reports"
else
  fail "destination catalog metadata failed: $metadata"
  failures=$((failures + 1))
fi

echo ""

# ── SBOM ──
echo "=== SBOM (Software Bill of Materials) ==="
echo ""
echo "Runtime dependencies:"
echo "  CBQN (dzaima/BQN)  — BQN implementation, commit 12a4fb9f+"
echo ""
echo "Optional tools:"
echo "  fzf  — fuzzy selector for add-ui.sh / main-ui.sh"
echo "  gum  — terminal widgets for add-ui.sh"
echo "  rg   — ripgrep for check scripts"
echo ""
echo "Dev tools (bundled):"
echo "  bqn-eval, bqn-dump, query, ledger-check, ledger-inspect, report-summary, scaffold-check.sh, repo-index"
echo ""

# ── Result ──
echo "=== Result ==="
if [[ "$all_ok" -eq 1 ]]; then
  echo "${green}All checks passed.${reset}"
  exit 0
else
  echo "${red}$failures issue(s) found.${reset}"
  exit 1
fi
