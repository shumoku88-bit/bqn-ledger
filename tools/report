#!/usr/bin/env bash
# Production retained-report CLI over semantic query coordinates.
# Canonical Household sources are resolved internally from BASE and never appear
# in argv or manifest-selected source coordinates.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  tools/report BASE envelopes SURFACE DOMAIN START END_EXCLUSIVE OBSERVATION
  tools/report BASE balances SURFACE DOMAIN AS_OF
  tools/report BASE balance-sheet human DOMAIN AS_OF
  tools/report BASE profit-and-loss human DOMAIN START END_EXCLUSIVE
  tools/report BASE recent SURFACE THROUGH LIMIT
  tools/report BASE planned SURFACE OBSERVATION
  tools/report BASE cycle-accounts human DOMAIN OBSERVATION
  tools/report BASE cycle-comparison human DOMAIN CURRENT_OBS BASELINE_OBS POLICY
  tools/report BASE monthly-accounts human DOMAIN FIRST_MONTH LAST_MONTH_EXCLUSIVE
  tools/report BASE daily-flow human DOMAIN START END_EXCLUSIVE OBSERVATION
  tools/report BASE daily-target SURFACE DOMAIN OBSERVATION TARGET
  tools/report BASE issues human

Physical Household source basenames are not Report query coordinates. Historical
queries remain available by supplying the semantic dates/domain/policy explicitly.
USAGE
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then usage; exit 0; fi
if [[ $# -lt 3 ]]; then usage >&2; exit 2; fi

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
key=$2
surface=$3
shift 3
[[ $base == /* ]] || base="$caller_pwd/$base"
cd "$root"

if [[ $key == all || ${1:-} == --manifest ]]; then
  printf 'ERROR\treport_manifest_retired\tReport manifests are not execution inputs; use canonical report.toml or explicit semantic coordinates\n' >&2
  exit 2
fi

request_output=""
if ! request_output="$(bqn src/application/report_request_cli.bqn "$key" "$surface" 2>&1)"; then
  printf '%s\n' "$request_output" >&2
  exit 1
fi

coordinates=("$@")
route_plan_output=""
if route_plan_output="$(bqn src/application/report_route_plan_cli.bqn "$key" "$surface" "${coordinates[@]}" 2>&1)"; then
  :
else
  status=$?
  printf '%s\n' "$route_plan_output" >&2
  code=$(awk -F'\t' 'NR==1 && $1=="ERROR" {print $2}' <<<"$route_plan_output")
  [[ $code == usage_* ]] && exit 2
  exit "$status"
fi

IFS=$'\t' read -r record plan_key plan_surface coordinate_count source_count extra <<<"$route_plan_output"
if [[ $record != ROUTE || $plan_key != "$key" || $plan_surface != "$surface" || -n ${extra:-} ]]; then
  printf 'ERROR\treport_route_plan_invalid\troute header does not match admitted request\n' >&2
  exit 1
fi
if [[ ! $coordinate_count =~ ^[0-9]+$ || ! $source_count =~ ^[0-9]+$ || $source_count -ne 0 || $coordinate_count -ne ${#coordinates[@]} ]]; then
  printf 'ERROR\treport_route_plan_invalid\tsemantic route must contain argv coordinates and no physical sources\n' >&2
  exit 1
fi

if [[ ! -r config/currencies.tsv ]]; then
  printf 'ERROR\tcurrency_registry_unreadable\tcurrency registry is not readable\n' >&2
  exit 1
fi

exec bqn src/application/report_destination_cli.bqn "$base" "$key" "$surface" "${coordinates[@]}"
