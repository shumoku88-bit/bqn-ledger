#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  printf 'Usage: tools/home-calendar BASE [FOCUS_DATE] [calendar|detail|detail-frame|choices|cells|frame|day-prev|day-next|week-prev|week-next|month-prev|month-next]\n' >&2
  exit 2
fi

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
focus=${2:-}
mode=${3:-}
[[ $base == /* ]] || base="$caller_pwd/$base"
cd "$root"

run_bqn() {
  local focus_value="$1" mode_value="${2:-}"
  local -a args=("$base")
  [[ -z $focus_value ]] || args+=("$focus_value")
  [[ -z $mode_value ]] || args+=("$mode_value")
  bqn src/application/home_calendar_cli.bqn "${args[@]}"
}

# Explicit modes and non-interactive consumers retain the stable application
# contract. A terminal call without a mode becomes the calendar-matrix cursor.
if [[ -n $mode || ! -t 0 || ! -t 1 ]]; then
  args=("$base")
  [[ -z $focus ]] || args+=("$focus")
  [[ -z $mode ]] || args+=("$mode")
  exec bqn src/application/home_calendar_cli.bqn "${args[@]}"
fi

[[ -n $focus ]] || focus="$(date +%Y-%m-%d)"
frame_separator=$'\nHOME_CURSOR_CELLS\n'
detail_separator=$'\nHOME_SELECTED_DETAIL\n'
calendar=''
dates=()
rows=()
cols=()
texts=()
selected_date=''
selected_index=0
max_row=0
home_error=''

# Apply one BQN-owned cursor publication. This function commits the shell cache
# only after the complete semantic CellRelation has parsed successfully.
apply_cursor_frame() {
  local focus_value="$1" frame_text="$2"
  local next_calendar next_cells
  local date_value row_value col_value cell_value index
  local next_selected_index=-1 next_max_row=0
  local -a next_dates=() next_rows=() next_cols=() next_texts=()

  [[ $frame_text == *"$frame_separator"* ]] || return 1
  next_calendar="${frame_text%%"$frame_separator"*}"
  next_cells="${frame_text#*"$frame_separator"}"

  while IFS=$'\t' read -r date_value row_value col_value cell_value; do
    [[ -n $date_value ]] || continue
    index=${#next_dates[@]}
    next_dates+=("$date_value")
    next_rows+=("$row_value")
    next_cols+=("$col_value")
    next_texts+=("$cell_value")
    [[ $date_value == "$focus_value" ]] && next_selected_index=$index
    (( row_value > next_max_row )) && next_max_row=$row_value
  done <<<"$next_cells"

  ((${#next_dates[@]} > 0)) || return 1
  (( next_selected_index >= 0 )) || return 1

  calendar=$next_calendar
  dates=("${next_dates[@]}")
  rows=("${next_rows[@]}")
  cols=("${next_cols[@]}")
  texts=("${next_texts[@]}")
  selected_date=$focus_value
  selected_index=$next_selected_index
  max_row=$next_max_row
}

# Reload one BQN-owned month from one application publication. Calendar text and
# its semantic CellRelation are produced by the same Household observation.
load_calendar() {
  local focus_value="$1" next_frame
  next_frame="$(run_bqn "$focus_value" frame)" || return 1
  apply_cursor_frame "$focus_value" "$next_frame"
}

# selected_date is the logical Home coordinate. selected_index is only the
# current CellRelation projection used to draw the cursor efficiently.
select_date() {
  local date_value="$1" i
  for ((i=0; i<${#dates[@]}; i++)); do
    if [[ ${dates[i]} == "$date_value" ]]; then
      selected_date=$date_value
      selected_index=$i
      return 0
    fi
  done
  load_calendar "$date_value"
}

shift_focus() {
  local shift_mode="$1" next_focus
  next_focus="$(run_bqn "$selected_date" "$shift_mode")" || return 1
  select_date "$next_focus"
}

load_calendar "$focus" || {
  echo 'Error: Home calendar returned no cursor frame for focus date' >&2
  exit 1
}

read_home_key() {
  local first='' second='' third='' fourth='' payload='' ch=''
  IFS= read -rsn1 first </dev/tty || return 1
  if [[ $first == $'\e' ]]; then
    if IFS= read -rsn1 -t 0.05 second </dev/tty; then
      if [[ $second == '[' ]] && IFS= read -rsn1 -t 0.05 third </dev/tty; then
        case "$third" in
          A) printf 'up\n'; return 0 ;;
          B) printf 'down\n'; return 0 ;;
          C) printf 'right\n'; return 0 ;;
          D) printf 'left\n'; return 0 ;;
          5|6)
            if IFS= read -rsn1 -t 0.05 fourth </dev/tty && [[ $fourth == '~' ]]; then
              [[ $third == 5 ]] && printf 'page-up\n' || printf 'page-down\n'
              return 0
            fi
            ;;
          '<')
            while IFS= read -rsn1 -t 0.05 ch </dev/tty; do
              if [[ $ch == M || $ch == m ]]; then
                printf 'mouse;%s;%s\n' "$payload" "$ch"
                return 0
              fi
              payload+="$ch"
            done
            ;;
        esac
      fi
    fi
    printf 'escape\n'
  elif [[ -z $first ]]; then
    printf 'enter\n'
  else
    printf '%s\n' "$first"
  fi
}

render_cursor() {
  local row col line column footer
  row=${rows[selected_index]}
  col=${cols[selected_index]}
  line=$((3 + row))
  column=$((1 + 4 * col))
  footer=$((4 + max_row))

  printf '\033[H\033[2J%s\n' "$calendar" >/dev/tty
  printf '\033[%d;%dH\033[7m%s\033[0m' "$line" "$column" "${texts[selected_index]}" >/dev/tty
  printf '\033[%d;1H\033[J' "$footer" >/dev/tty
  printf 'Home date: %s\n' "$selected_date" >/dev/tty
  printf '← → ↑ ↓ / h j k l: move   [ ] / PgUp PgDn: month\n' >/dev/tty
  printf 'Click / Enter: inspect   q / Esc: back\n' >/dev/tty
}

terminal_rows() {
  local measured_rows measured_cols
  if read -r measured_rows measured_cols < <(stty size </dev/tty 2>/dev/null) \
    && [[ $measured_rows =~ ^[0-9]+$ ]] && (( measured_rows > 0 )); then
    printf '%s\n' "$measured_rows"
  else
    printf '24\n'
  fi
}

detail_capacity() {
  local screen_rows pane_top capacity
  screen_rows="$(terminal_rows)"
  pane_top=$((7 + max_row))
  capacity=$((screen_rows - pane_top - 1))
  (( capacity > 0 )) || capacity=1
  printf '%s\n' "$capacity"
}

render_detail_frame() {
  local detail_text="$1" detail_offset="$2"
  local footer pane_top screen_rows capacity count max_offset end i first_line last_line
  local -a detail_lines=()

  render_cursor
  mapfile -t detail_lines <<<"$detail_text"
  count=${#detail_lines[@]}
  screen_rows="$(terminal_rows)"
  footer=$((4 + max_row))
  pane_top=$((footer + 3))
  capacity="$(detail_capacity)"
  max_offset=$((count > capacity ? count - capacity : 0))
  (( detail_offset <= max_offset )) || detail_offset=$max_offset
  (( detail_offset >= 0 )) || detail_offset=0
  end=$((detail_offset + capacity))
  (( end <= count )) || end=$count

  printf '\033[%d;1H\033[J--- Selected date detail ---\n' "$pane_top" >/dev/tty
  for ((i=detail_offset; i<end; i++)); do
    printf '%s\n' "${detail_lines[i]}" >/dev/tty
  done

  first_line=$((count == 0 ? 0 : detail_offset + 1))
  last_line=$end
  if (( screen_rows > pane_top )); then
    printf '\033[%d;1H\033[2KDetail %d-%d/%d   ↑ ↓ / k j: scroll   PgUp PgDn: page   Enter / Space: calendar   q / Esc: back' \
      "$screen_rows" "$first_line" "$last_line" "$count" >/dev/tty
  fi
}

mouse_hit_index=-1
mouse_hit_test() {
  local mouse_x="$1" mouse_y="$2" i line column
  mouse_hit_index=-1
  for ((i=0; i<${#dates[@]}; i++)); do
    line=$((3 + rows[i]))
    column=$((1 + 4 * cols[i]))
    if (( mouse_y == line && mouse_x >= column && mouse_x <= column + 2 )); then
      mouse_hit_index=$i
      return 0
    fi
  done
  return 1
}

enable_home_mouse() {
  printf '\033[?1000h\033[?1006h' >/dev/tty
}

disable_home_mouse() {
  printf '\033[?1006l\033[?1000l' >/dev/tty
}

# Inspect receives calendar, CellRelation, and selected-date detail from one
# application observation. The complete BQN detail remains in memory while this
# terminal frontend exposes only the currently visible viewport.
show_detail() {
  local detail_key detail_publication cursor_frame detail_text status
  local detail_offset=0 capacity count max_offset
  local -a detail_lines=()

  disable_home_mouse
  if detail_publication="$(run_bqn "$selected_date" detail-frame)"; then
    :
  else
    status=$?
    home_error=$detail_publication
    enable_home_mouse
    return "$status"
  fi

  if [[ $detail_publication != *"$detail_separator"* ]]; then
    home_error='Error: Home detail frame publication is missing selected-detail boundary'
    enable_home_mouse
    return 1
  fi
  cursor_frame="${detail_publication%%"$detail_separator"*}"
  detail_text="${detail_publication#*"$detail_separator"}"
  if ! apply_cursor_frame "$selected_date" "$cursor_frame"; then
    home_error='Error: Home detail frame publication contains an invalid cursor frame'
    enable_home_mouse
    return 1
  fi

  mapfile -t detail_lines <<<"$detail_text"
  count=${#detail_lines[@]}
  while true; do
    capacity="$(detail_capacity)"
    max_offset=$((count > capacity ? count - capacity : 0))
    (( detail_offset <= max_offset )) || detail_offset=$max_offset
    render_detail_frame "$detail_text" "$detail_offset"
    if ! detail_key="$(read_home_key)"; then
      enable_home_mouse
      return 130
    fi
    case "$detail_key" in
      up|k|K)
        if (( detail_offset > 0 )); then
          detail_offset=$((detail_offset - 1))
        fi
        ;;
      down|j|J)
        if (( detail_offset < max_offset )); then
          detail_offset=$((detail_offset + 1))
        fi
        ;;
      page-up)
        detail_offset=$((detail_offset > capacity ? detail_offset - capacity : 0))
        ;;
      page-down)
        detail_offset=$((detail_offset + capacity))
        (( detail_offset <= max_offset )) || detail_offset=$max_offset
        ;;
      q|Q|escape)
        enable_home_mouse
        return 130
        ;;
      enter|' ')
        enable_home_mouse
        return 0
        ;;
      *)
        enable_home_mouse
        return 0
        ;;
    esac
  done
}

cleanup_home_cursor() {
  disable_home_mouse 2>/dev/null || true
  printf '\033[?25h\033[?1049l' >/dev/tty 2>/dev/null || true
  if [[ -n $home_error ]]; then
    printf '%s\n' "$home_error" >&2
  fi
}
trap cleanup_home_cursor EXIT
trap 'exit 130' INT TERM HUP
printf '\033[?1049h\033[?25l' >/dev/tty
enable_home_mouse

while true; do
  render_cursor
  key="$(read_home_key)" || exit 130
  case "$key" in
    left|h|H)
      shift_focus day-prev || printf '\a' >/dev/tty ;;
    right|l|L)
      shift_focus day-next || printf '\a' >/dev/tty ;;
    up|k|K)
      shift_focus week-prev || printf '\a' >/dev/tty ;;
    down|j|J)
      shift_focus week-next || printf '\a' >/dev/tty ;;
    page-up|\[)
      shift_focus month-prev || printf '\a' >/dev/tty ;;
    page-down|\])
      shift_focus month-next || printf '\a' >/dev/tty ;;
    mouse\;*)
      IFS=';' read -r event button mouse_x mouse_y mouse_state <<<"$key"
      [[ $event == mouse ]] || continue
      [[ $button =~ ^[0-9]+$ && $mouse_x =~ ^[0-9]+$ && $mouse_y =~ ^[0-9]+$ ]] || continue
      [[ $button == 0 ]] || continue
      if mouse_hit_test "$mouse_x" "$mouse_y"; then
        select_date "${dates[mouse_hit_index]}" || continue
        if [[ $mouse_state == M ]]; then
          render_cursor
        elif [[ $mouse_state == m ]]; then
          if show_detail; then :; else exit $?; fi
        fi
      fi
      ;;
    enter)
      if show_detail; then :; else exit $?; fi
      ;;
    q|Q|escape)
      exit 130 ;;
  esac
done
