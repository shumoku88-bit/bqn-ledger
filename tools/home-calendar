#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  printf 'Usage: tools/home-calendar BASE [FOCUS_DATE] [calendar|detail|choices|cells]\n' >&2
  exit 2
fi

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
focus=${2:-}
mode=${3:-}
[[ $base == /* ]] || base="$caller_pwd/$base"
cd "$root"

run_bqn() {
  local focus_value="$1" mode_value="${2:-}"
  local -a args=("$base")
  [[ -z $focus_value ]] || args+=("$focus_value")
  [[ -z $mode_value ]] || args+=("$mode_value")
  bqn src/application/home_calendar_cli.bqn "${args[@]}"
}

# Explicit modes and non-interactive consumers retain the stable application
# contract. A terminal call without a mode becomes the calendar-matrix cursor.
if [[ -n $mode || ! -t 0 || ! -t 1 ]]; then
  args=("$base")
  [[ -z $focus ]] || args+=("$focus")
  [[ -z $mode ]] || args+=("$mode")
  exec bqn src/application/home_calendar_cli.bqn "${args[@]}"
fi

[[ -n $focus ]] || focus="$(date +%Y-%m-%d)"
calendar="$(run_bqn "$focus" calendar)"
cells="$(run_bqn "$focus" cells)"

dates=()
rows=()
cols=()
texts=()
selected_index=0
max_row=0
while IFS=$'\t' read -r date_value row_value col_value cell_value; do
  [[ -n $date_value ]] || continue
  index=${#dates[@]}
  dates+=("$date_value")
  rows+=("$row_value")
  cols+=("$col_value")
  texts+=("$cell_value")
  [[ $date_value == "$focus" ]] && selected_index=$index
  (( row_value > max_row )) && max_row=$row_value
done <<<"$cells"

((${#dates[@]} > 0)) || {
  echo 'Error: Home calendar returned no cursor cells' >&2
  exit 1
}

read_home_key() {
  local first='' second='' third=''
  IFS= read -rsn1 first </dev/tty || return 1
  if [[ $first == $'\e' ]]; then
    if IFS= read -rsn1 -t 0.05 second </dev/tty; then
      if [[ $second == '[' ]] && IFS= read -rsn1 -t 0.05 third </dev/tty; then
        case "$third" in
          A) printf 'up\n'; return 0 ;;
          B) printf 'down\n'; return 0 ;;
          C) printf 'right\n'; return 0 ;;
          D) printf 'left\n'; return 0 ;;
        esac
      fi
    fi
    printf 'escape\n'
  elif [[ -z $first ]]; then
    printf 'enter\n'
  else
    printf '%s\n' "$first"
  fi
}

render_cursor() {
  local row col line column footer selected_date
  row=${rows[selected_index]}
  col=${cols[selected_index]}
  selected_date=${dates[selected_index]}
  line=$((3 + row))
  column=$((1 + 4 * col))
  footer=$((4 + max_row))

  printf '\033[H\033[2J%s\n' "$calendar" >/dev/tty
  printf '\033[%d;%dH\033[7m%s\033[0m' "$line" "$column" "${texts[selected_index]}" >/dev/tty
  printf '\033[%d;1H\033[J' "$footer" >/dev/tty
  printf 'Home date: %s\n' "$selected_date" >/dev/tty
  printf '← → ↑ ↓ / h j k l: move   Enter: inspect   q / Esc: back\n' >/dev/tty
}

show_detail() {
  local detail_key
  printf '\033[H\033[2J' >/dev/tty
  run_bqn "${dates[selected_index]}" detail >/dev/tty
  printf '\nAny key: calendar   q / Esc: back\n' >/dev/tty
  detail_key="$(read_home_key)" || return 130
  case "$detail_key" in
    q|Q|escape) return 130 ;;
    *) return 0 ;;
  esac
}

cleanup_home_cursor() {
  printf '\033[?25h\033[?1049l' >/dev/tty 2>/dev/null || true
}
trap cleanup_home_cursor EXIT
trap 'exit 130' INT TERM HUP
printf '\033[?1049h\033[?25l' >/dev/tty

while true; do
  render_cursor
  key="$(read_home_key)" || exit 130
  case "$key" in
    left|h|H)
      (( selected_index > 0 )) && selected_index=$((selected_index - 1)) ;;
    right|l|L)
      (( selected_index + 1 < ${#dates[@]} )) && selected_index=$((selected_index + 1)) ;;
    up|k|K)
      (( selected_index >= 7 )) && selected_index=$((selected_index - 7)) ;;
    down|j|J)
      (( selected_index + 7 < ${#dates[@]} )) && selected_index=$((selected_index + 7)) ;;
    enter)
      show_detail || exit 130 ;;
    q|Q|escape)
      exit 130 ;;
  esac
done
