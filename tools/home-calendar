#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  printf 'Usage: tools/home-calendar BASE [FOCUS_DATE] [calendar|detail|choices|cells|day-prev|day-next|month-prev|month-next]\n' >&2
  exit 2
fi

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
focus=${2:-}
mode=${3:-}
[[ $base == /* ]] || base="$caller_pwd/$base"
cd "$root"

run_bqn() {
  local focus_value="$1" mode_value="${2:-}"
  local -a args=("$base")
  [[ -z $focus_value ]] || args+=("$focus_value")
  [[ -z $mode_value ]] || args+=("$mode_value")
  bqn src/application/home_calendar_cli.bqn "${args[@]}"
}

# Explicit modes and non-interactive consumers retain the stable application
# contract. A terminal call without a mode becomes the calendar-matrix cursor.
if [[ -n $mode || ! -t 0 || ! -t 1 ]]; then
  args=("$base")
  [[ -z $focus ]] || args+=("$focus")
  [[ -z $mode ]] || args+=("$mode")
  exec bqn src/application/home_calendar_cli.bqn "${args[@]}"
fi

[[ -n $focus ]] || focus="$(date +%Y-%m-%d)"
calendar=''
cells=''
dates=()
rows=()
cols=()
texts=()
selected_index=0
max_row=0

# Reload one BQN-owned month atomically. The shell receives rendered calendar
# text plus the date/row/column/cell relation; it never calculates Gregorian
# month boundaries, day clipping, weekdays, or semantic markers itself.
load_calendar() {
  local focus_value="$1" next_calendar next_cells
  local date_value row_value col_value cell_value index
  local next_selected_index=-1 next_max_row=0
  local -a next_dates=() next_rows=() next_cols=() next_texts=()

  next_calendar="$(run_bqn "$focus_value" calendar)" || return 1
  next_cells="$(run_bqn "$focus_value" cells)" || return 1

  while IFS=$'\t' read -r date_value row_value col_value cell_value; do
    [[ -n $date_value ]] || continue
    index=${#next_dates[@]}
    next_dates+=("$date_value")
    next_rows+=("$row_value")
    next_cols+=("$col_value")
    next_texts+=("$cell_value")
    [[ $date_value == "$focus_value" ]] && next_selected_index=$index
    (( row_value > next_max_row )) && next_max_row=$row_value
  done <<<"$next_cells"

  ((${#next_dates[@]} > 0)) || return 1
  (( next_selected_index >= 0 )) || return 1

  focus=$focus_value
  calendar=$next_calendar
  cells=$next_cells
  dates=("${next_dates[@]}")
  rows=("${next_rows[@]}")
  cols=("${next_cols[@]}")
  texts=("${next_texts[@]}")
  selected_index=$next_selected_index
  max_row=$next_max_row
}

shift_focus() {
  local shift_mode="$1" next_focus
  next_focus="$(run_bqn "${dates[selected_index]}" "$shift_mode")" || return 1
  load_calendar "$next_focus"
}

load_calendar "$focus" || {
  echo 'Error: Home calendar returned no cursor cells for focus date' >&2
  exit 1
}

read_home_key() {
  local first='' second='' third='' fourth='' payload='' ch=''
  IFS= read -rsn1 first </dev/tty || return 1
  if [[ $first == $'\e' ]]; then
    if IFS= read -rsn1 -t 0.05 second </dev/tty; then
      if [[ $second == '[' ]] && IFS= read -rsn1 -t 0.05 third </dev/tty; then
        case "$third" in
          A) printf 'up\n'; return 0 ;;
          B) printf 'down\n'; return 0 ;;
          C) printf 'right\n'; return 0 ;;
          D) printf 'left\n'; return 0 ;;
          5|6)
            if IFS= read -rsn1 -t 0.05 fourth </dev/tty && [[ $fourth == '~' ]]; then
              [[ $third == 5 ]] && printf 'page-up\n' || printf 'page-down\n'
              return 0
            fi
            ;;
          '<')
            while IFS= read -rsn1 -t 0.05 ch </dev/tty; do
              if [[ $ch == M || $ch == m ]]; then
                printf 'mouse;%s;%s\n' "$payload" "$ch"
                return 0
              fi
              payload+="$ch"
            done
            ;;
        esac
      fi
    fi
    printf 'escape\n'
  elif [[ -z $first ]]; then
    printf 'enter\n'
  else
    printf '%s\n' "$first"
  fi
}

render_cursor() {
  local row col line column footer selected_date
  row=${rows[selected_index]}
  col=${cols[selected_index]}
  selected_date=${dates[selected_index]}
  line=$((3 + row))
  column=$((1 + 4 * col))
  footer=$((4 + max_row))

  printf '\033[H\033[2J%s\n' "$calendar" >/dev/tty
  printf '\033[%d;%dH\033[7m%s\033[0m' "$line" "$column" "${texts[selected_index]}" >/dev/tty
  printf '\033[%d;1H\033[J' "$footer" >/dev/tty
  printf 'Home date: %s\n' "$selected_date" >/dev/tty
  printf '← → ↑ ↓ / h j k l: move   [ ] / PgUp PgDn: month\n' >/dev/tty
  printf 'Click / Enter: inspect   q / Esc: back\n' >/dev/tty
}

mouse_hit_index=-1
mouse_hit_test() {
  local mouse_x="$1" mouse_y="$2" i line column
  mouse_hit_index=-1
  for ((i=0; i<${#dates[@]}; i++)); do
    line=$((3 + rows[i]))
    column=$((1 + 4 * cols[i]))
    if (( mouse_y == line && mouse_x >= column && mouse_x <= column + 2 )); then
      mouse_hit_index=$i
      return 0
    fi
  done
  return 1
}

enable_home_mouse() {
  printf '\033[?1000h\033[?1006h' >/dev/tty
}

disable_home_mouse() {
  printf '\033[?1006l\033[?1000l' >/dev/tty
}

show_detail() {
  local detail_key
  disable_home_mouse
  printf '\033[H\033[2J' >/dev/tty
  run_bqn "${dates[selected_index]}" detail >/dev/tty
  printf '\nAny key: calendar   q / Esc: back\n' >/dev/tty
  if ! detail_key="$(read_home_key)"; then
    enable_home_mouse
    return 130
  fi
  enable_home_mouse
  case "$detail_key" in
    q|Q|escape) return 130 ;;
    *) return 0 ;;
  esac
}

cleanup_home_cursor() {
  disable_home_mouse 2>/dev/null || true
  printf '\033[?25h\033[?1049l' >/dev/tty 2>/dev/null || true
}
trap cleanup_home_cursor EXIT
trap 'exit 130' INT TERM HUP
printf '\033[?1049h\033[?25l' >/dev/tty
enable_home_mouse

while true; do
  render_cursor
  key="$(read_home_key)" || exit 130
  case "$key" in
    left|h|H)
      if (( selected_index > 0 )); then
        selected_index=$((selected_index - 1))
      else
        shift_focus day-prev || printf '\a' >/dev/tty
      fi
      ;;
    right|l|L)
      if (( selected_index + 1 < ${#dates[@]} )); then
        selected_index=$((selected_index + 1))
      else
        shift_focus day-next || printf '\a' >/dev/tty
      fi
      ;;
    up|k|K)
      (( selected_index >= 7 )) && selected_index=$((selected_index - 7)) ;;
    down|j|J)
      (( selected_index + 7 < ${#dates[@]} )) && selected_index=$((selected_index + 7)) ;;
    page-up|\[)
      shift_focus month-prev || printf '\a' >/dev/tty ;;
    page-down|\])
      shift_focus month-next || printf '\a' >/dev/tty ;;
    mouse\;*)
      IFS=';' read -r event button mouse_x mouse_y mouse_state <<<"$key"
      [[ $event == mouse ]] || continue
      [[ $button =~ ^[0-9]+$ && $mouse_x =~ ^[0-9]+$ && $mouse_y =~ ^[0-9]+$ ]] || continue
      [[ $button == 0 ]] || continue
      if mouse_hit_test "$mouse_x" "$mouse_y"; then
        selected_index=$mouse_hit_index
        if [[ $mouse_state == M ]]; then
          render_cursor
        elif [[ $mouse_state == m ]]; then
          show_detail || exit 130
        fi
      fi
      ;;
    enter)
      show_detail || exit 130 ;;
    q|Q|escape)
      exit 130 ;;
  esac
done
