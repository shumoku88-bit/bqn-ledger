#!/usr/bin/env bash
set -euo pipefail

# Public editor dispatcher.
#
# Stronger canonical publication slices with additional observation/fence laws
# have dedicated shell effect owners below. Remaining editor commands use the
# shared tools/edit-bqn path. This file is routing only: it owns no accounting,
# candidate construction, source mutation algorithm, or validation semantics.

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"

args=("$@")
i=0
while (( i < ${#args[@]} )); do
  case "${args[$i]}" in
    --base) i=$((i + 2)) ;;
    --) i=$((i + 1)); break ;;
    *) break ;;
  esac
done

if [[ "${args[$i]-}" == "plan" && "${args[$((i + 1))]-}" == "add" ]]; then
  exec bash "$DIR/plan-add" "$@"
fi
if [[ "${args[$i]-}" == "plan" && "${args[$((i + 1))]-}" == "edit" ]]; then
  exec bash "$DIR/plan-edit" "$@"
fi
if [[ "${args[$i]-}" == "plan" && "${args[$((i + 1))]-}" == "finish" ]]; then
  exec bash "$DIR/plan-finish" "$@"
fi
if [[ "${args[$i]-}" == "budget" && "${args[$((i + 1))]-}" == "add" ]]; then
  exec bash "$DIR/budget-write" "$@"
fi
if [[ "${args[$i]-}" == "journal" ]]; then
  case "${args[$((i + 1))]-}" in
    canonical-surface-plan|canonical-surface-preview|canonical-surface-apply)
      exec bash "$DIR/journal-canonical-surface" "$@"
      ;;
  esac
fi

exec "$DIR/edit-bqn" "$@"