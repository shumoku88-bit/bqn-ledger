#!/usr/bin/env python3
"""Inventory executable BQN primitive tokens at a fixed git ref."""
import argparse, json, os, re, subprocess, sys
from collections import Counter, defaultdict
from pathlib import Path

BASE_DOC = "mlochbaum/BQN@1d43de0a8d66010c55f26fafb967c648d2fefade"
FUN = "+-×÷⋆√⌊⌈∧∨¬|≤<>≥=≠≡≢⊣⊢⥊∾≍⋈↑↓↕»«⌽⍉/⍋⍒⊏⊑⊐⊒∊⍷⊔!"
MOD1 = "˙˜˘¨⌜⁼´˝`"
MOD2 = "∘○⊸⟜⌾⊘◶⎉⚇⍟⎊"
NAMES = [
("+","Conjugate / Add"),("-","Negate / Subtract"),("×","Sign / Multiply"),("÷","Reciprocal / Divide"),("⋆","Exponential / Power"),("√","Square Root / Root"),("⌊","Floor / Minimum"),("⌈","Ceiling / Maximum"),("∧","Sort Up / And"),("∨","Sort Down / Or"),("¬","Not / Span"),("|","Absolute Value / Modulus"),("≤","Less Than or Equal To"),("<","Enclose / Less Than"),(">","Merge / Greater Than"),("≥","Greater Than or Equal To"),("=","Rank / Equals"),("≠","Length / Not Equals"),("≡","Depth / Match"),("≢","Shape / Not Match"),("⊣","Identity / Left"),("⊢","Identity / Right"),("⥊","Deshape / Reshape"),("∾","Join / Join To"),("≍","Solo / Couple"),("⋈","Enlist / Pair"),("↑","Prefixes / Take"),("↓","Suffixes / Drop"),("↕","Range / Windows"),("»","Nudge / Shift Before"),("«","Nudge Back / Shift After"),("⌽","Reverse / Rotate"),("⍉","Transpose / Reorder Axes"),("/","Indices / Replicate"),("⍋","Grade Up / Bins Up"),("⍒","Grade Down / Bins Down"),("⊏","First Cell / Select"),("⊑","First / Pick"),("⊐","Classify / Index Of"),("⊒","Occurrence Count / Progressive Index Of"),("∊","Mark Firsts / Member Of"),("⍷","Deduplicate / Find"),("⊔","Group Indices / Group"),("!","Assert / Assert with Message"),("˙","Constant"),("˜","Self / Swap"),("˘","Cells"),("¨","Each"),("⌜","Table"),("⁼","Undo"),("´","Fold"),("˝","Insert"),("`","Scan"),("∘","Atop"),("○","Over"),("⊸","Before / Bind"),("⟜","After / Bind"),("⌾","Under"),("⊘","Valences"),("◶","Choose"),("⎉","Rank"),("⚇","Depth"),("⍟","Repeat"),("⎊","Catch")]
SPECIAL = "𝕨𝕩𝕗𝕘𝕤𝕣𝕎𝕏𝔽𝔾𝕊"
SYSTEM = re.compile(r"•[A-Za-z_][A-Za-z0-9_]*")
CORPORA = ("production","editor","tools","tests","support","documentation","archive")


def run(*args, binary=False):
    r=subprocess.run(args,check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return r.stdout if binary else r.stdout.decode("utf-8","replace")

def corpus(path):
    if path.startswith("docs/archive/"): return "archive"
    if path.startswith(("src/editor/","src_edit/")): return "editor"
    if path.startswith("src/"): return "production"
    if path.startswith("tools/"): return "tools"
    if path.startswith("tests/"): return "tests"
    if path.startswith("docs/"): return "documentation"
    return "support"

def regions(text):
    text=text.replace("\r\n","\n").replace("\r","\n"); i=0; line=1
    while i<len(text):
        c=text[i]
        if c=="#":
            while i<len(text) and text[i]!="\n": yield text[i],line,"comment"; i+=1
            continue
        if c=="'":
            yield c,line,"character"; i+=1
            if i<len(text):
                yield text[i],line,"character"; line+=text[i]=="\n"; i+=1
            if i<len(text) and text[i]=="'": yield text[i],line,"character"; i+=1
            continue
        if c=='"':
            yield c,line,"string"; i+=1
            while i<len(text):
                c=text[i]; yield c,line,"string"; line+=c=="\n"
                if c=='"':
                    if i+1<len(text) and text[i+1]=='"': i+=1; yield text[i],line,"string"; i+=1; continue
                    i+=1; break
                i+=1
            continue
        yield c,line,"code"; line+=c=="\n"; i+=1

def sources(ref):
    ref=run("git","rev-parse",ref).strip()
    raw=run("git","ls-tree","-r","--name-only","-z",ref,binary=True)
    for b in raw.split(b"\0"):
        if not b: continue
        p=os.fsdecode(b); text=run("git","show",f"{ref}:{p}")
        first=text.splitlines()[0] if text else ""
        if p.endswith(".bqn") or (first.startswith("#!") and re.search(r"(?:^|[/ ])bqn(?:$|\s)",first)):
            yield ref,p,text

def build(ref):
    code=defaultdict(list); noncode=defaultdict(list); special=defaultdict(list); systems=defaultdict(list); files=[]
    resolved=None
    for resolved,p,text in sources(ref):
        cp=corpus(p); files.append((p,cp)); chars=list(regions(text)); mask=[]; lines=[]
        for c,line,ctx in chars:
            loc=(cp,p,line)
            if c in FUN+MOD1+MOD2: (code if ctx=="code" else noncode)[c].append((*loc,ctx))
            if c in SPECIAL and ctx=="code": special[c].append(loc)
            mask.append(c if ctx=="code" else " "); lines.append(line)
        for m in SYSTEM.finditer("".join(mask)): systems[m.group()].append((cp,p,lines[m.start()]))
    if resolved is None: resolved=run("git","rev-parse",ref).strip()
    def locs(rows): return [{"corpus":r[0],"path":r[1],"line":r[2]} for r in rows]
    return {"commit":resolved,"official_source":BASE_DOC,"files":[{"path":p,"corpus":c} for p,c in files],
      "primitives":{g:{"role":"function" if g in FUN else "1-modifier" if g in MOD1 else "2-modifier","name":n,"code":locs(code[g]),"noncode":locs(noncode[g])} for g,n in NAMES},
      "special":{g:locs(special[g]) for g in SPECIAL},"systems":{g:locs(v) for g,v in sorted(systems.items())}}

def report(d):
    fc=Counter(x["corpus"] for x in d["files"]); out=["# BQN primitive usage inventory","","Status: mechanically generated observation","",f"Repository baseline: `{d['commit']}`",f"Official primitive source: `{d['official_source']}`",f"Tracked BQN source files: {len(d['files'])}","","Executable tokens are separated from comments and text literals using BQN token precedence.","Documentation and archive code do not make a primitive present in the current runtime.","","## Corpus","","| Corpus | Files |","|---|---:|"]
    out += [f"| {c} | {fc[c]} |" for c in CORPORA]
    out += ["","## Primitive summary","","| Glyph | Role | Official name | Prod | Editor | Tools | Tests | Support | Docs | Archive | Non-code | Runtime |","|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---|"]
    unused=[]
    for g,n in NAMES:
        r=d["primitives"][g]; cc=Counter(x["corpus"] for x in r["code"]); runtime=sum(cc[c] for c in CORPORA[:5]); status="used" if runtime else "unused"
        if not runtime: unused.append(g)
        out.append(f"| `{g}` | {r['role']} | {n} | {cc['production']} | {cc['editor']} | {cc['tools']} | {cc['tests']} | {cc['support']} | {cc['documentation']} | {cc['archive']} | {len(r['noncode'])} | **{status}** |")
    out += ["",f"Runtime-unused total: **{len(unused)} of {len(NAMES)}**.","", "Runtime-unused glyphs: " + " ".join(f"`{g}`" for g in unused),"","## Representative executable locations",""]
    for g,n in NAMES:
        rows=d["primitives"][g]["code"]; seen=[]
        for x in rows:
            k=(x["path"],x["line"])
            if k not in seen: seen.append(k)
            if len(seen)==5: break
        if seen: out.append(f"- `{g}` {n}: "+", ".join(f"`{p}:{l}`" for p,l in seen))
    out += ["","## Modifier special names","","| Name | Executable count | Corpora |","|---|---:|---|"]
    for g in SPECIAL:
        rows=d["special"][g]; c=Counter(x["corpus"] for x in rows); out.append(f"| `{g}` | {len(rows)} | "+", ".join(f"{k}:{v}" for k,v in sorted(c.items()))+" |")
    out += ["","## System values","","| Name | Executable count | Corpora |","|---|---:|---|"]
    for g,rows in d["systems"].items():
        c=Counter(x["corpus"] for x in rows); out.append(f"| `{g}` | {len(rows)} | "+", ".join(f"{k}:{v}" for k,v in sorted(c.items()))+" |")
    out += ["","## Reproduction","","```sh",f"python3 tools/bqn-primitive-inventory --ref {d['commit']} --format markdown",f"python3 tools/bqn-primitive-inventory --ref {d['commit']} --format json","```",""]
    return "\n".join(out)

def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--ref",default="HEAD"); ap.add_argument("--format",choices=("markdown","json"),default="markdown"); ap.add_argument("--check"); a=ap.parse_args()
    if len(FUN)!=44 or len(MOD1)+len(MOD2)!=20 or len(NAMES)!=64: raise SystemExit("primitive catalog cardinality drift")
    d=build(a.ref); text=report(d) if a.format=="markdown" else json.dumps(d,ensure_ascii=False,indent=2,sort_keys=True)+"\n"
    if a.check:
        if Path(a.check).read_text(encoding="utf-8")!=text: print(f"inventory drift: regenerate {a.check}",file=sys.stderr); return 1
        return 0
    sys.stdout.write(text); return 0
if __name__=="__main__": raise SystemExit(main())
