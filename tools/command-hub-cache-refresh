#!/usr/bin/env bash
set -euo pipefail

# Build the command-hub preview cache away from live preview files, then publish
# complete files atomically. Callers may run this synchronously or in the
# background; an exclusive lock prevents duplicate refreshes.

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

if [[ $# -ne 3 ]]; then
  echo "Usage: tools/command-hub-cache-refresh <base> <cache-dir> <source-mtime>" >&2
  exit 2
fi

base_abs="$1"
cache_dir="$2"
source_mtime="$3"
[[ "$source_mtime" =~ ^[0-9]+$ ]] || { echo "Error: source mtime must be a non-negative integer" >&2; exit 2; }
[[ -d "$base_abs" ]] || { echo "Error: base directory does not exist" >&2; exit 2; }
mkdir -p "$cache_dir"

lock_dir="$cache_dir/.refresh-lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  if [[ "$lock_pid" =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
    exit 0
  fi
  rm -rf "$lock_dir"
  mkdir "$lock_dir" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock_dir/pid"

refreshing_file="$cache_dir/.cache-refreshing"
error_file="$cache_dir/.cache-error"
touch "$refreshing_file"
rm -f "$error_file"
stage_dir="$(mktemp -d "$cache_dir/.refresh-stage.XXXXXX")"
full_stage="$stage_dir/full"
mkdir "$full_stage"
success=0

cleanup() {
  status=$?
  rm -rf "$stage_dir"
  if [[ "$success" -ne 1 ]]; then
    printf 'Preview cache generation failed. Run tools/report directly for current data.\n' >"$error_file"
  else
    rm -f "$cache_dir/.refresh.log"
  fi
  rm -f "$refreshing_file"
  rm -rf "$lock_dir"
  return "$status"
}
trap cleanup EXIT

if [[ "${BQN_LEDGER_TEST_MODE:-}" == "1" && -n "${COMMAND_HUB_CACHE_TEST_BEFORE_BUILD_HOOK:-}" ]]; then
  "$COMMAND_HUB_CACHE_TEST_BEFORE_BUILD_HOOK"
fi

# BQN owns every cached section body, including selected-currency balances.
# This shell boundary only stages, validates, and atomically publishes files.
"$ROOT_DIR/tools/report" "$base_abs" --write-section-cache "$full_stage" --no-color \
  >/dev/null 2>"$stage_dir/full.err"

key_manifest="$full_stage/.section-keys"
[[ -s "$key_manifest" ]] || { echo "Error: report cache key manifest is missing or empty" >&2; exit 1; }
if [[ -n "$(LC_ALL=C sort "$key_manifest" | uniq -d)" ]]; then
  echo "Error: report cache key manifest contains duplicate keys" >&2
  exit 1
fi
key_count=0
has_all=0
while IFS= read -r key; do
  key_count=$((key_count + 1))
  [[ "$key" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "Error: invalid report cache key: $key" >&2; exit 1; }
  [[ "$key" == "all" ]] && has_all=1
  [[ -f "$full_stage/$key.txt" ]] || { echo "Error: incomplete preview cache: $key" >&2; exit 1; }
done <"$key_manifest"
[[ "$key_count" -gt 0 && "$has_all" -eq 1 ]] || { echo "Error: incomplete report cache key manifest" >&2; exit 1; }

# Each visible file and then its canonical key manifest is published by atomic
# rename. The timestamp is published last as the complete-generation commit.
while IFS= read -r key; do
  mv -f "$full_stage/$key.txt" "$cache_dir/$key.txt"
done <"$key_manifest"
mv -f "$key_manifest" "$cache_dir/.section-keys"
timestamp_tmp="$(mktemp "$cache_dir/.cache-timestamp.XXXXXX")"
printf '%s\n' "$source_mtime" >"$timestamp_tmp"
mv -f "$timestamp_tmp" "$cache_dir/.cache-timestamp"
rm -f "$error_file"
success=1
