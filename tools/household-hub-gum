#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
source "$root/tools/lib/system-defaults.sh"
source "$root/tools/lib/theme.sh"
source "$root/tools/lib/ui-preferences.sh"
source "$root/tools/lib/ui-choice.sh"

usage() {
  cat <<'EOF'
Usage: tools/household-hub-gum [--base DIR] [--date YYYY-MM-DD] [--list]

Flat searchable gum Command Palette for the Household application.
Calendar is a sibling destination, not the Hub's information architecture.
Nested selectors retain the user's independent BL_SELECTOR preference.
EOF
}

base="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
selected_date="$(date +%Y-%m-%d)"
list_only=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; base=$2; shift 2 ;;
    --date) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; selected_date=$2; shift 2 ;;
    --list) list_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Error: unexpected argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ $selected_date =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || {
  echo 'Error: --date must be YYYY-MM-DD' >&2
  exit 2
}

build_palette() {
  local action_index domain operation scope key label kind
  printf 'meta:calendar\tBrowse Calendar                               Date / browse\n'
  printf 'meta:reports\tBrowse Reports                                Reports / preview + search\n'
  while IFS=$'\t' read -r action_index domain operation scope key label kind; do
    [[ $action_index == action_index ]] && continue
    printf 'action:%s\t%-44s %s / %s / %s\n' "$key" "$label" "$domain" "$operation" "$scope"
  done < <("$root/tools/household-surface-metadata" actions)
  printf 'meta:edit\tOpen canonical source                         Source & System\n'
  printf 'meta:check\tHousehold check                               Source & System\n'
  printf 'meta:inspect\tLedger / provenance inspection                Source & System\n'
  printf 'meta:doctor\tDependency and source diagnosis                Source & System\n'
  printf 'meta:export\tExport canonical Journals to hledger           Source & System\n'
  printf 'meta:summary\tCompact report summary                         Source & System\n'
  printf 'meta:query\tExact compact-key query                        Source & System\n'
  printf 'meta:dev-check\tRepository development suite                   Source & System\n'
}

palette="$(build_palette)"
if [[ $list_only -eq 1 ]]; then
  printf '%s\n' "$palette"
  exit 0
fi

[[ -t 0 && -t 1 ]] || {
  echo 'Error: gum Command Hub requires an interactive terminal' >&2
  exit 2
}
command -v gum >/dev/null 2>&1 || {
  echo 'Error: gum Command Hub requires gum' >&2
  exit 2
}

run_bl() {
  BL_SELECTED_DATE="$selected_date" \
    "$root/tools/bl" --base "$base" --latest "$selected_date" "$@"
}

pause_return() {
  printf '\nPress Enter to return to Command Hub...' >/dev/tty
  IFS= read -r _ </dev/tty || true
}

dispatch() {
  local key=$1 status=0
  case "$key" in
    meta:calendar)
      "$root/tools/home-calendar" "$base" "$selected_date" || {
        status=$?
        [[ $status -eq 130 ]] || return "$status"
      }
      return 0
      ;;
    meta:reports) run_bl reports ;;
    meta:edit) run_bl edit ;;
    meta:check) run_bl check ;;
    meta:inspect) run_bl inspect ;;
    meta:doctor) run_bl doctor ;;
    meta:export) run_bl export ;;
    meta:summary) run_bl summary ;;
    meta:query) run_bl query ;;
    meta:dev-check) run_bl dev-check ;;
    action:*)
      "$root/tools/household-action" \
        --base "$base" --date "$selected_date" "${key#action:}"
      ;;
    *)
      echo "Error: unknown Command Hub key: $key" >&2
      return 2
      ;;
  esac
}

while true; do
  prompt="Household Command Hub · $selected_date · command / report / plan / issue / account"
  set +e
  selection="$(printf '%s\n' "$palette" | cut -f2- | BL_SELECTOR=gum bl_ui_choose_line "$prompt")"
  status=$?
  set -e
  [[ $status -eq 0 && -n $selection ]] || exit 0

  key="$(awk -F'\t' -v selected="$selection" \
    'substr($0,index($0,"\t")+1)==selected {print $1; found++} END {if(found!=1) exit 1}' <<<"$palette")" || {
      echo 'Error: selected Command Hub row is ambiguous' >&2
      exit 1
    }

  set +e
  dispatch "$key"
  status=$?
  set -e
  if [[ $status -ne 0 && $status -ne 130 ]]; then
    printf '\nCommand failed with status %s.\n' "$status" >&2
  fi
  [[ $key == meta:calendar ]] || pause_return
done
