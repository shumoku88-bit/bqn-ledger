#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/system-defaults.sh
source "$ROOT_DIR/tools/lib/system-defaults.sh"
# shellcheck source=tools/lib/safe-write.sh
source "$ROOT_DIR/tools/lib/safe-write.sh"
# shellcheck source=tools/lib/edit-bqn-common.sh
source "$ROOT_DIR/tools/lib/edit-bqn-common.sh"

BASE_DIR="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) BASE_DIR="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"

if [[ "${1-}" != "plan" || "${2-}" != "finish" ]]; then
  echo 'ERROR: tools/plan-finish handles only: plan finish' >&2
  exit 2
fi
shift 2

INDEX="0"; PLAN_ID=""; ACTUAL_DATE=""; ACTUAL_AMOUNT=""
APPLY=0; DRY_RUN_EXPLICIT=0; YES=0; POST_CHECK="lint"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --index) INDEX="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --id) PLAN_ID="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --actual-date) ACTUAL_DATE="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --actual-amount) ACTUAL_AMOUNT="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --apply) APPLY=1; shift ;;
    --dry-run) DRY_RUN_EXPLICIT=1; shift ;;
    --yes) YES=1; shift ;;
    --post-check) POST_CHECK="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    *) echo "ERROR: unknown plan finish option: $1" >&2; exit 2 ;;
  esac
done
[[ "$INDEX" != "0" || -n "$PLAN_ID" ]] || { echo 'ERROR: must specify plan to finish using --index or --id' >&2; exit 2; }
[[ -n "$ACTUAL_DATE" ]] || { echo 'ERROR: missing required option: --actual-date' >&2; exit 2; }
[[ ! ( "$APPLY" -eq 1 && "$DRY_RUN_EXPLICIT" -eq 1 ) ]] || { echo 'ERROR: cannot specify both --apply and --dry-run' >&2; exit 2; }
[[ ! ( "$YES" -eq 1 && "$APPLY" -eq 0 ) ]] || { echo 'ERROR: --yes requires --apply' >&2; exit 2; }
edit_bqn_validate_post_check "$POST_CHECK"
DRY_RUN=1
[[ "$APPLY" -eq 1 ]] && DRY_RUN=0

[[ -d "$BASE_DIR" ]] || { echo "ERROR: base directory does not exist: $BASE_DIR" >&2; exit 1; }
CANONICAL_BASE="$(cd -P "$BASE_DIR" && pwd)"
PLAN_PATH="$CANONICAL_BASE/plan.journal"
ACTUAL_PATH="$CANONICAL_BASE/actual.journal"
for path in "$PLAN_PATH" "$ACTUAL_PATH"; do
  [[ -f "$path" ]] || { echo "ERROR: canonical source is not a regular file: $path" >&2; exit 1; }
  [[ ! -L "$path" ]] || { echo "ERROR: canonical source symlink is rejected: $path" >&2; exit 1; }
done

PLAN_TOKEN="$(safe_snapshot_token "$PLAN_PATH")"
IFS=$'\t' read -r PLAN_SIZE PLAN_MTIME PLAN_SHA256 <<< "$PLAN_TOKEN"
ACTUAL_TOKEN="$(safe_snapshot_token "$ACTUAL_PATH")"
IFS=$'\t' read -r ACTUAL_SIZE ACTUAL_MTIME ACTUAL_SHA256 <<< "$ACTUAL_TOKEN"

INTENT_STDERR="$(mktemp)"
BLOCK_STDERR="$(mktemp)"
trap 'rm -f "$INTENT_STDERR" "$BLOCK_STDERR"' EXIT
INTENT_OUT=""
if ! INTENT_OUT="$(cd "$ROOT_DIR" && bqn src_edit/plan_finish_cmd.bqn "$CANONICAL_BASE" "$INDEX" "$PLAN_ID" "$ACTUAL_DATE" "$ACTUAL_AMOUNT" 2>"$INTENT_STDERR")"; then
  [[ -n "$INTENT_OUT" ]] && printf '%s\n' "$INTENT_OUT" >&2
  [[ -s "$INTENT_STDERR" ]] && cat "$INTENT_STDERR" >&2
  exit 1
fi
mapfile -t INTENT_LINES <<< "$INTENT_OUT"
[[ ${#INTENT_LINES[@]} -ge 3 ]] || { echo 'ERROR: incomplete Plan finish intent protocol' >&2; exit 1; }
IFS=$'\t' read -r STATUS OP FINISH_ID FINISH_DATE CURRENCY POSTING_COUNT DESCRIPTION EXTRA <<< "${INTENT_LINES[0]}"
if [[ -n "${EXTRA:-}" || "$STATUS" != "OK" || "$OP" != "PLAN_FINISH" || -z "$FINISH_ID" || "$FINISH_DATE" != "$ACTUAL_DATE" || ! "$POSTING_COUNT" =~ ^[0-9]+$ || "$POSTING_COUNT" -lt 2 || -z "$DESCRIPTION" ]]; then
  echo "ERROR: invalid Plan finish intent header: ${INTENT_LINES[0]}" >&2
  exit 1
fi
[[ ${#INTENT_LINES[@]} -eq $((POSTING_COUNT + 1)) ]] || { echo 'ERROR: Plan finish intent posting count mismatch' >&2; exit 1; }
POSTINGS=()
for ((i=1; i<${#INTENT_LINES[@]}; i++)); do
  IFS=$'\t' read -r ROW_KIND ROW_VALUE ROW_EXTRA <<< "${INTENT_LINES[$i]}"
  [[ "$ROW_KIND" == "P" && -n "$ROW_VALUE" && -z "${ROW_EXTRA:-}" ]] || { echo "ERROR: invalid Plan finish posting protocol: ${INTENT_LINES[$i]}" >&2; exit 1; }
  POSTINGS+=("$ROW_VALUE")
done

EVENT_ID="completion-${FINISH_ID}-${FINISH_DATE}"
BLOCK_OUT=""
if ! BLOCK_OUT="$(cd "$ROOT_DIR" && bqn src_edit/journal_block_add_cmd.bqn \
  "$CANONICAL_BASE" "$ACTUAL_PATH" "$FINISH_DATE" "$DESCRIPTION" durable "$EVENT_ID" \
  "currency=$CURRENCY" "${#POSTINGS[@]}" "${POSTINGS[@]}" "plan_id=$FINISH_ID" 2>"$BLOCK_STDERR")"; then
  [[ -n "$BLOCK_OUT" ]] && printf '%s\n' "$BLOCK_OUT" >&2
  [[ -s "$BLOCK_STDERR" ]] && cat "$BLOCK_STDERR" >&2
  exit 1
fi
if ! edit_bqn_split_protocol_output "$BLOCK_OUT"; then exit 1; fi
IFS=$'\t' read -r B_STATUS B_OP TRANSPORT_PREFIX B_IDENTITY B_EVENT B_POSTING_COUNT CANDIDATE_ORDINAL B_EXTRA <<< "$EDIT_BQN_PROTOCOL_FIRST_LINE"
if [[ -n "${B_EXTRA:-}" || "$B_STATUS" != "OK" || "$B_OP" != "APPEND_BLOCK" || "$B_IDENTITY" != "durable" || "$B_EVENT" != "$EVENT_ID" || "$B_POSTING_COUNT" != "$POSTING_COUNT" || ! "$TRANSPORT_PREFIX" =~ ^[01]$ || ! "$CANDIDATE_ORDINAL" =~ ^[0-9]+$ ]]; then
  echo "ERROR: invalid Actual candidate protocol: $EDIT_BQN_PROTOCOL_FIRST_LINE" >&2
  exit 1
fi
CANDIDATE_BLOCK="$EDIT_BQN_PROTOCOL_PAYLOAD"
[[ -n "$CANDIDATE_BLOCK" ]] || { echo 'ERROR: Plan finish produced an empty Actual candidate' >&2; exit 1; }

_safe_write_check_expected_snapshot "$PLAN_PATH" "$PLAN_SIZE" "$PLAN_MTIME" "$PLAN_SHA256" || exit 1
_safe_write_check_expected_snapshot "$ACTUAL_PATH" "$ACTUAL_SIZE" "$ACTUAL_MTIME" "$ACTUAL_SHA256" || exit 1

MODE="$(edit_bqn_mode "$DRY_RUN" "$YES")"
printf 'Plan completion preview\n'
printf 'Plan source: %s\nActual target: %s\nPlan ID: %s\nMode: %s\nPost-check: %s\n' \
  "$PLAN_PATH" "$ACTUAL_PATH" "$FINISH_ID" "$MODE" "$POST_CHECK"
printf 'Actual transaction:\n%s\n' "$CANDIDATE_BLOCK"
if [[ "$DRY_RUN" -eq 1 ]]; then
  echo 'Dry-run only. No files were modified.'
  exit 0
fi
if [[ "$YES" -eq 0 ]]; then
  printf 'Complete this Plan into Actual? [y/N]: '
  reply=""; read -r reply || true
  case "$reply" in y|Y|yes|YES) ;; *) echo 'Cancelled. No files were modified.'; exit 0 ;; esac
fi

edit_bqn_run_test_hook EDIT_BQN_TEST_BEFORE_PLAN_FINISH_APPEND_HOOK
_safe_write_check_expected_snapshot "$PLAN_PATH" "$PLAN_SIZE" "$PLAN_MTIME" "$PLAN_SHA256" || exit 1
_safe_write_check_expected_snapshot "$ACTUAL_PATH" "$ACTUAL_SIZE" "$ACTUAL_MTIME" "$ACTUAL_SHA256" || exit 1
TRANSPORT_PAYLOAD="$CANDIDATE_BLOCK"
[[ "$TRANSPORT_PREFIX" -eq 0 ]] || TRANSPORT_PAYLOAD=$'\n'"$CANDIDATE_BLOCK"
WRITE_OUT="$(safe_append_checked "$ACTUAL_PATH" "$TRANSPORT_PAYLOAD" "$ACTUAL_SIZE" "$ACTUAL_MTIME" "$ACTUAL_SHA256")"
printf '%s\n' "$WRITE_OUT"
BACKUP_PATH="$(awk -F': ' '$1 == "Backup" {print $2}' <<< "$WRITE_OUT")"
[[ -f "$BACKUP_PATH" ]] || { echo 'ERROR: checked Actual append did not report one backup' >&2; exit 1; }
POST_WRITE_SHA="$(_safe_write_sha256 "$ACTUAL_PATH")"

append_mandatory_output() {
  local text="$1"
  [[ -n "$text" ]] || return 0
  if [[ -n "$MANDATORY_OUT" ]]; then MANDATORY_OUT+=$'\n'; fi
  MANDATORY_OUT+="$text"
}

MANDATORY_OK=1
MANDATORY_OUT=""
STEP_OUT=""
if ! _safe_write_check_expected_snapshot "$PLAN_PATH" "$PLAN_SIZE" "$PLAN_MTIME" "$PLAN_SHA256"; then
  MANDATORY_OK=0
  append_mandatory_output 'Plan source changed during completion publication'
fi
if [[ "$MANDATORY_OK" -eq 1 && "${BQN_LEDGER_TEST_MODE:-}" == "1" && "${EDIT_BQN_TEST_FORCE_PLAN_FINISH_POST_CHECK_FAIL:-}" == "1" ]]; then
  MANDATORY_OK=0
  append_mandatory_output 'forced Plan completion post-admission failure'
fi
if [[ "$MANDATORY_OK" -eq 1 ]]; then
  STEP_OUT=""
  if ! STEP_OUT="$(cd "$ROOT_DIR" && bqn src_edit/journal_native_source_check.bqn \
      "$CANONICAL_BASE" "$ACTUAL_PATH" "$FINISH_DATE" "$DESCRIPTION" durable "$EVENT_ID" "$CANDIDATE_ORDINAL" \
      "currency=$CURRENCY" "${POSTINGS[@]}" 2>&1)"; then
    MANDATORY_OK=0
  fi
  append_mandatory_output "$STEP_OUT"
fi
if [[ "$MANDATORY_OK" -eq 1 ]]; then
  STEP_OUT=""
  if ! STEP_OUT="$(cd "$ROOT_DIR" && bqn src_edit/plan_finish_validate_cmd.bqn "$CANONICAL_BASE" "$FINISH_ID" "$FINISH_DATE" 2>&1)"; then
    MANDATORY_OK=0
  fi
  append_mandatory_output "$STEP_OUT"
fi
if [[ "$MANDATORY_OK" -eq 1 ]]; then
  STEP_OUT=""
  if ! STEP_OUT="$(cd "$ROOT_DIR" && "$ROOT_DIR/tools/ledger-check" "$CANONICAL_BASE" 2>&1)"; then
    MANDATORY_OK=0
  fi
  append_mandatory_output "$STEP_OUT"
fi
if [[ "$MANDATORY_OK" -eq 1 ]] && ! _safe_write_check_expected_snapshot "$PLAN_PATH" "$PLAN_SIZE" "$PLAN_MTIME" "$PLAN_SHA256"; then
  MANDATORY_OK=0
  append_mandatory_output 'Plan source changed before mandatory completion validation finished'
fi

if [[ "$MANDATORY_OK" -eq 1 ]]; then
  printf 'Mandatory Plan completion validation: OK\n%s\n' "$MANDATORY_OUT"
else
  printf 'Mandatory Plan completion validation: FAILED\n%s\n' "$MANDATORY_OUT" >&2
fi

OPTIONAL_OK=1
if [[ "$MANDATORY_OK" -eq 1 && "$POST_CHECK" == "full" ]]; then
  printf 'Additional full check: starting\n'
  if ! (cd "$ROOT_DIR" && bash tools/check.sh); then
    OPTIONAL_OK=0
  else
    printf 'Additional full check: OK\n'
  fi
elif [[ "$MANDATORY_OK" -eq 1 ]]; then
  printf 'Additional check: none (%s mode)\n' "$POST_CHECK"
fi

# Publication succeeds only while the observed Plan is still the same and the
# Actual target still equals exactly the candidate bytes this operation wrote.
if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 ]] && \
   ! _safe_write_check_expected_snapshot "$PLAN_PATH" "$PLAN_SIZE" "$PLAN_MTIME" "$PLAN_SHA256"; then
  MANDATORY_OK=0
  append_mandatory_output 'Plan source changed before completion publication returned'
fi
if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 && "$(_safe_write_sha256 "$ACTUAL_PATH")" != "$POST_WRITE_SHA" ]]; then
  MANDATORY_OK=0
  append_mandatory_output 'Actual source changed after completion publication validation'
fi

if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 ]]; then exit 0; fi
edit_bqn_run_test_hook EDIT_BQN_TEST_BEFORE_POSTCHECK_ROLLBACK_HOOK
if safe_restore_backup_checked "$ACTUAL_PATH" "$BACKUP_PATH" "$POST_WRITE_SHA"; then
  if [[ "$(_safe_write_sha256 "$ACTUAL_PATH")" != "$ACTUAL_SHA256" ]]; then
    echo 'Rollback: restore digest mismatch; recovery required' >&2
    exit 1
  fi
  echo 'Rollback: restored original Actual bytes' >&2
  exit 1
fi
echo 'Rollback: refused; Actual changed after completion append; recovery required' >&2
exit 1