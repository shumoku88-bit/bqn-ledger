#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tools/lib/system-defaults.sh
source "$ROOT_DIR/tools/lib/system-defaults.sh"
# shellcheck source=tools/lib/safe-write.sh
source "$ROOT_DIR/tools/lib/safe-write.sh"
# shellcheck source=tools/lib/edit-bqn-common.sh
source "$ROOT_DIR/tools/lib/edit-bqn-common.sh"

BASE_DIR="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
TARGET_FILE="entitlement.journal"
CANONICAL_FILES=(
  accounts.journal actual.journal plan.journal entitlement.journal
  envelope.toml household.toml report.toml issues.tsv
)

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      BASE_DIR="$(get_opt_val "$1" "${2-}")"
      shift 2
      ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"

SUBCOMMAND=""
if [[ "${1-}" == "entitlement" && ( "${2-}" == "transfer" || "${2-}" == "add" ) ]] || \
   [[ "${1-}" == "budget" && ( "${2-}" == "add" || "${2-}" == "move" ) ]] || \
   [[ "${1-}" == "envelope" && "${2-}" == "transfer" ]]; then
  SUBCOMMAND="transfer"
  shift 2
elif [[ "${1-}" == "entitlement" && "${2-}" == "origin" ]] || \
     [[ "${1-}" == "envelope" && "${2-}" == "origin" ]]; then
  SUBCOMMAND="origin"
  shift 2
else
  echo 'ERROR: tools/entitlement-write handles: entitlement transfer|origin' >&2
  exit 2
fi

DATE=""; MEMO=""; FROM=""; TO=""; AMOUNT=""; CURRENCY=""
DRY_RUN=0; YES=0; POST_CHECK="lint"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --date) DATE="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --memo) MEMO="$(get_opt_val_allow_empty "$1" "${2-}")"; shift 2 ;;
    --from) FROM="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --to) TO="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --amount) AMOUNT="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --currency) CURRENCY="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) YES=1; shift ;;
    --post-check) POST_CHECK="$(get_opt_val "$1" "${2-}")"; shift 2 ;;
    *) echo "ERROR: unknown Entitlement write option: $1" >&2; exit 2 ;;
  esac
done
edit_bqn_validate_post_check "$POST_CHECK"

[[ -d "$BASE_DIR" ]] || { echo "ERROR: base directory does not exist: $BASE_DIR" >&2; exit 1; }
CANONICAL_BASE="$(cd -P "$BASE_DIR" && pwd)"
TARGET_PATH="$CANONICAL_BASE/$TARGET_FILE"

HOUSEHOLD_SIZE=()
HOUSEHOLD_MTIME=()
HOUSEHOLD_SHA=()
for file in "${CANONICAL_FILES[@]}"; do
  path="$CANONICAL_BASE/$file"
  [[ -f "$path" ]] || { echo "ERROR: canonical source is not a regular file: $path" >&2; exit 1; }
  [[ ! -L "$path" ]] || { echo "ERROR: canonical source symlink is rejected: $path" >&2; exit 1; }
  token="$(safe_snapshot_token "$path")"
  IFS=$'\t' read -r size mtime sha <<< "$token"
  HOUSEHOLD_SIZE+=("$size")
  HOUSEHOLD_MTIME+=("$mtime")
  HOUSEHOLD_SHA+=("$sha")
done

entitlement_index=3
SNAP_SIZE="${HOUSEHOLD_SIZE[$entitlement_index]}"
SNAP_MTIME="${HOUSEHOLD_MTIME[$entitlement_index]}"
SNAP_SHA256="${HOUSEHOLD_SHA[$entitlement_index]}"

fence_initial_household() {
  local i file path
  for i in "${!CANONICAL_FILES[@]}"; do
    file="${CANONICAL_FILES[$i]}"
    path="$CANONICAL_BASE/$file"
    _safe_write_check_expected_snapshot \
      "$path" "${HOUSEHOLD_SIZE[$i]}" "${HOUSEHOLD_MTIME[$i]}" "${HOUSEHOLD_SHA[$i]}" || return 1
  done
}

fence_nonentitlement_household() {
  local i file path
  for i in "${!CANONICAL_FILES[@]}"; do
    [[ "$i" -eq "$entitlement_index" ]] && continue
    file="${CANONICAL_FILES[$i]}"
    path="$CANONICAL_BASE/$file"
    _safe_write_check_expected_snapshot \
      "$path" "${HOUSEHOLD_SIZE[$i]}" "${HOUSEHOLD_MTIME[$i]}" "${HOUSEHOLD_SHA[$i]}" || return 1
  done
}

# Refuse to publish into an already-invalid canonical Household observation.
"$ROOT_DIR/tools/ledger-check" "$CANONICAL_BASE" >/dev/null
fence_initial_household

BQN_STDERR="$(mktemp)"
trap 'rm -f "$BQN_STDERR"' EXIT
BQN_OUT=""
if [[ "$SUBCOMMAND" == "transfer" ]]; then
  BQN_COMMAND=(bqn src_edit/entitlement_add_cmd.bqn "$CANONICAL_BASE" "$DATE" "$MEMO" "$FROM" "$TO" "$AMOUNT" "$CURRENCY")
else
  BQN_COMMAND=(bqn src_edit/entitlement_origin_cmd.bqn "$CANONICAL_BASE" "$DATE" "$MEMO" "$CURRENCY")
fi

if ! BQN_OUT="$(cd "$ROOT_DIR" && "${BQN_COMMAND[@]}" 2>"$BQN_STDERR")"; then
  [[ -n "$BQN_OUT" ]] && printf '%s\n' "$BQN_OUT" >&2
  [[ -s "$BQN_STDERR" ]] && cat "$BQN_STDERR" >&2
  exit 1
fi
if ! edit_bqn_split_protocol_output "$BQN_OUT"; then exit 1; fi
if ! edit_bqn_require_append_protocol "$EDIT_BQN_PROTOCOL_FIRST_LINE" "$TARGET_FILE"; then exit 1; fi
PAYLOAD="$EDIT_BQN_PROTOCOL_PAYLOAD"
fence_initial_household

MODE="$(edit_bqn_mode "$DRY_RUN" "$YES")"
printf 'Entitlement %s append preview\n' "$SUBCOMMAND"
printf 'Target: %s\n' "$TARGET_PATH"
printf 'Mode: %s\n' "$MODE"
printf 'Post-check: %s\n' "$POST_CHECK"
printf 'Entitlement line:\n%s\n' "$PAYLOAD"
if [[ "$DRY_RUN" -eq 1 ]]; then
  printf 'Dry-run only. No files were modified.\n'
  exit 0
fi
if [[ "$YES" -eq 0 ]] && ! confirm_append; then
  echo 'Cancelled. No files were modified.'
  exit 0
fi

edit_bqn_run_test_hook EDIT_BQN_TEST_BEFORE_ENTITLEMENT_APPEND_HOOK
fence_initial_household
WRITE_OUT=""
if ! WRITE_OUT="$(safe_append_checked "$TARGET_PATH" "$PAYLOAD" "$SNAP_SIZE" "$SNAP_MTIME" "$SNAP_SHA256")"; then
  exit 1
fi
printf '%s\n' "$WRITE_OUT"
BACKUP_PATH="$(awk -F': ' '$1 == "Backup" {print $2}' <<< "$WRITE_OUT")"
[[ -f "$BACKUP_PATH" ]] || { echo 'ERROR: checked Entitlement append did not report one backup' >&2; exit 1; }
POST_WRITE_SHA="$(_safe_write_sha256 "$TARGET_PATH")"

append_mandatory_output() {
  local text="$1"
  [[ -n "$text" ]] || return 0
  if [[ -n "$MANDATORY_OUT" ]]; then MANDATORY_OUT+=$'\n'; fi
  MANDATORY_OUT+="$text"
}

MANDATORY_OK=1
MANDATORY_OUT=""
STEP_OUT=""
if ! fence_nonentitlement_household; then
  MANDATORY_OK=0
  append_mandatory_output 'canonical Household source changed during Entitlement publication'
fi
if [[ "$MANDATORY_OK" -eq 1 && "${BQN_LEDGER_TEST_MODE:-}" == "1" && "${EDIT_BQN_TEST_FORCE_ENTITLEMENT_POST_CHECK_FAIL:-}" == "1" ]]; then
  MANDATORY_OK=0
  append_mandatory_output 'forced canonical Entitlement post-admission failure'
fi
if [[ "$MANDATORY_OK" -eq 1 ]]; then
  STEP_OUT=""
  if ! STEP_OUT="$(cd "$ROOT_DIR" && bqn src_edit/entitlement_validate_cmd.bqn "$CANONICAL_BASE" 2>&1)"; then
    MANDATORY_OK=0
  fi
  append_mandatory_output "$STEP_OUT"
fi
if [[ "$MANDATORY_OK" -eq 1 ]]; then
  STEP_OUT=""
  if ! STEP_OUT="$(cd "$ROOT_DIR" && "$ROOT_DIR/tools/ledger-check" "$CANONICAL_BASE" 2>&1)"; then
    MANDATORY_OK=0
  fi
  append_mandatory_output "$STEP_OUT"
fi
if [[ "$MANDATORY_OK" -eq 1 ]] && ! fence_nonentitlement_household; then
  MANDATORY_OK=0
  append_mandatory_output 'canonical Household source changed before Entitlement validation finished'
fi
if [[ "$MANDATORY_OK" -eq 1 && "$(_safe_write_sha256 "$TARGET_PATH")" != "$POST_WRITE_SHA" ]]; then
  MANDATORY_OK=0
  append_mandatory_output 'Entitlement source changed after canonical validation'
fi

if [[ "$MANDATORY_OK" -eq 1 ]]; then
  printf 'Mandatory Entitlement validation: OK\n%s\n' "$MANDATORY_OUT"
else
  printf 'Mandatory Entitlement validation: FAILED\n%s\n' "$MANDATORY_OUT" >&2
fi

OPTIONAL_OK=1
if [[ "$MANDATORY_OK" -eq 1 && "$POST_CHECK" == "full" ]]; then
  printf 'Additional full check: starting\n'
  if ! (cd "$ROOT_DIR" && bash tools/check.sh); then
    OPTIONAL_OK=0
  else
    printf 'Additional full check: OK\n'
  fi
elif [[ "$MANDATORY_OK" -eq 1 ]]; then
  printf 'Additional check: none (%s mode)\n' "$POST_CHECK"
fi

if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 ]] && ! fence_nonentitlement_household; then
  MANDATORY_OK=0
  append_mandatory_output 'canonical Household source changed before Entitlement publication returned'
fi
if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 && "$(_safe_write_sha256 "$TARGET_PATH")" != "$POST_WRITE_SHA" ]]; then
  MANDATORY_OK=0
  append_mandatory_output 'Entitlement source changed before publication returned'
fi
if [[ "$MANDATORY_OK" -eq 1 && "$OPTIONAL_OK" -eq 1 ]]; then
  exit 0
fi

edit_bqn_run_test_hook EDIT_BQN_TEST_BEFORE_POSTCHECK_ROLLBACK_HOOK
if safe_restore_backup_checked "$TARGET_PATH" "$BACKUP_PATH" "$POST_WRITE_SHA"; then
  if [[ "$(_safe_write_sha256 "$TARGET_PATH")" != "$SNAP_SHA256" ]]; then
    echo 'Rollback: restore digest mismatch; recovery required' >&2
    exit 1
  fi
  echo 'Rollback: restored original Entitlement bytes' >&2
  exit 1
fi
echo 'Rollback: refused; target changed after append; recovery required' >&2
exit 1
