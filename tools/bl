#!/usr/bin/env bash
set -euo pipefail

# tools/bl — Command Hub / doorway into bqn-ledger tools

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

source "$ROOT_DIR/tools/lib/system-defaults.sh"

usage() {
  cat <<EOF
Usage:
  tools/bl [--base <dir>] [command]

Commands:
  (no command)          Open interactive Command Hub
  report, all           Show the full report
  section [<key>]       Show report/action selector or direct section output
  add [mode]            Launch daily write UI
  browse [surface]      Browse transactions, plans, accounts, or issues
  transactions          List canonical Actual transactions
  plans                 List open canonical Plans
  accounts              List canonical Accounts
  issue-list            List Issues & Decisions
  check                 Validate the canonical eight-file Household source
  doctor                Check runtime dependencies and Household readiness
  inspect               Inspect canonical Actual identities and Postings
  export                Export canonical Journals for hledger
  query <domain> <key>  Run the exact ledger query for this Household root
  edit [<file>]         Open canonical source files in \$EDITOR
  dev-check             Run the repository development check suite
  help                  Show this help message

Options:
  --base <dir>          Specify canonical Household root
EOF
}

base_dir="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
cmd=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      if [[ $# -lt 2 ]]; then
        echo "Error: --base requires a directory" >&2
        usage >&2
        exit 1
      fi
      base_dir="$2"
      shift 2
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$cmd" ]]; then
        cmd="$1"
        shift
      else
        break
      fi
      ;;
  esac
done

source "$ROOT_DIR/tools/lib/theme.sh"

COLOR_HEADER="$ESC_HEADER"
COLOR_OK="$ESC_OK"
COLOR_ERROR="$ESC_ERROR"
COLOR_RESET="$ESC_RESET"

IS_TTY=0
if [[ -t 0 && -t 1 ]]; then
  IS_TTY=1
fi

print_header() {
  local title="$1"
  printf "${COLOR_HEADER}=== %s ===${COLOR_RESET}\n" "$title"
}

menu_list() {
  cat <<EOF
report	Show full report
section	Browse reports and daily actions
add	Record or change household entries
browse	Browse transactions, plans, accounts, and issues
check	Validate canonical Household source
doctor	Check runtime and Household readiness
inspect	Inspect canonical Actual facts
export	Export canonical Journals for hledger
edit	Open canonical source files in \$EDITOR
dev-check	Run repository development checks
exit	Exit
EOF
}

browse_list() {
  cat <<'EOF'
transactions	Actual transactions
plans	Open Plans
accounts	Accounts
issues	Issues & Decisions
back	Back to main menu
EOF
}

# Canonical Household files offered by the direct source editor.
source_list() {
  cat <<'EOF'
accounts.journal	Account declarations
actual.journal	Actual transactions
plan.journal	Future plans
budget.journal	Budget movements
budget.toml	Budget policy
household.toml	Household policy
report.toml	Report policy
issues.tsv	Pending issues and decisions
EOF
}

source_menu_list() {
  source_list
  printf 'back\tBack to main menu\n'
}

select_menu_key() {
  local prompt="$1" producer="$2"
  local selection="" status=0 key="" opt=""

  if command -v fzf >/dev/null 2>&1 && [[ "$IS_TTY" -eq 1 ]]; then
    set +e
    selection="$("$producer" | fzf --prompt="$prompt> " --delimiter=$'\t' --with-nth=2.. --reverse --exit-0)"
    status=$?
    set -e
    [[ "$status" -eq 130 || -z "$selection" ]] && return 130
    key="${selection%%$'\t'*}"
  elif command -v gum >/dev/null 2>&1 && [[ "$IS_TTY" -eq 1 ]]; then
    set +e
    selection="$("$producer" | gum filter "${GUM_FILTER_ARGS[@]}" --placeholder="$prompt")"
    status=$?
    set -e
    [[ "$status" -eq 130 || -z "$selection" ]] && return 130
    key="${selection%%$'\t'*}"
  else
    "$producer" | awk -F'\t' '{print NR ") " $2 " (" $1 ")"}' >&2
    printf '%s> ' "$prompt" >&2
    if ! read -r opt; then
      return 130
    fi
    if [[ "$opt" =~ ^[0-9]+$ ]]; then
      key="$("$producer" | sed -n "${opt}p" | cut -f1)"
    else
      key="$opt"
    fi
  fi

  [[ -n "$key" ]] || return 130
  printf '%s\n' "$key"
}

run_source_check() {
  print_header "Canonical Household Check"
  if "$ROOT_DIR/tools/ledger-check" "$base_dir"; then
    printf '%bCanonical Household source is valid.%b\n' "$COLOR_OK" "$COLOR_RESET"
    return 0
  else
    printf '%bCanonical Household source failed validation.%b\n' "$COLOR_ERROR" "$COLOR_RESET"
    return 1
  fi
}

run_dev_check() {
  print_header "Repository Development Checks"
  if "$ROOT_DIR/tools/check.sh"; then
    printf '%bAll repository checks passed successfully.%b\n' "$COLOR_OK" "$COLOR_RESET"
    return 0
  else
    printf '%bRepository checks failed. Please review errors above.%b\n' "$COLOR_ERROR" "$COLOR_RESET"
    return 1
  fi
}

run_doctor() {
  print_header "Doctor"
  LEDGER_DATA_DIR="$base_dir" "$ROOT_DIR/tools/doctor"
}

run_inspect() {
  print_header "Actual Inspection"
  "$ROOT_DIR/tools/ledger-inspect" "$base_dir"
}

run_export() {
  print_header "hledger Export"
  "$ROOT_DIR/tools/to-hledger" "$base_dir"
}

run_query() {
  "$ROOT_DIR/tools/query" "$base_dir" "$@"
}

run_browse_surface() {
  local surface="$1"
  case "$surface" in
    transactions)
      print_header "Actual Transactions"
      "$ROOT_DIR/tools/edit" --base "$base_dir" journal list --format text
      ;;
    plans)
      print_header "Open Plans"
      "$ROOT_DIR/tools/edit" --base "$base_dir" plan list --format text
      ;;
    accounts)
      print_header "Accounts"
      "$ROOT_DIR/tools/edit" --base "$base_dir" account list
      ;;
    issues)
      print_header "Issues & Decisions"
      "$ROOT_DIR/tools/edit" --base "$base_dir" issue list --format text
      ;;
    *)
      echo "Error: Unknown browse surface '$surface'" >&2
      return 2
      ;;
  esac
}

run_browse() {
  local surface="${1:-}" status=0
  if [[ -n "$surface" ]]; then
    run_browse_surface "$surface"
    return $?
  fi

  if [[ "$IS_TTY" -eq 0 ]]; then
    echo "Error: browse without a surface requires an interactive terminal." >&2
    echo "Use: tools/bl --base <dir> browse transactions|plans|accounts|issues" >&2
    return 2
  fi

  while true; do
    set +e
    surface="$(select_menu_key 'browse' browse_list)"
    status=$?
    set -e
    if [[ "$status" -eq 130 || "$surface" == "back" ]]; then
      return 0
    elif [[ "$status" -ne 0 ]]; then
      return "$status"
    fi
    run_browse_surface "$surface" || true
    echo ""
  done
}

select_source_file() {
  local selection="" status=0 file=""

  if command -v fzf >/dev/null 2>&1 && [[ "$IS_TTY" -eq 1 ]]; then
    set +e
    selection="$(source_menu_list | fzf --prompt='edit file> ' --delimiter=$'\t' --with-nth=2.. --reverse --exit-0)"
    status=$?
    set -e
    [[ "$status" -eq 130 || -z "$selection" ]] && return 130
    file="${selection%%$'\t'*}"
  elif command -v gum >/dev/null 2>&1 && [[ "$IS_TTY" -eq 1 ]]; then
    set +e
    selection="$(source_menu_list | gum filter "${GUM_FILTER_ARGS[@]}" --placeholder='edit file')"
    status=$?
    set -e
    [[ "$status" -eq 130 || -z "$selection" ]] && return 130
    file="${selection%%$'\t'*}"
  else
    source_menu_list >&2
    printf 'Enter file to edit (or back): ' >&2
    if ! read -r file; then
      return 130
    fi
  fi

  case "$file" in
    back|quit|exit|'') return 130 ;;
    *) printf '%s\n' "$file" ;;
  esac
}

resolve_source_path() {
  local file="$1"
  case "$file" in
    accounts.journal|actual.journal|plan.journal|budget.journal|budget.toml|household.toml|report.toml|issues.tsv)
      printf '%s\n' "$base_dir/$file"
      ;;
    *)
      printf '%s\n' "$file"
      ;;
  esac
}

ensure_editor() {
  if [[ -z "${EDITOR:-}" ]]; then
    EDITOR="nano"
    if command -v vim >/dev/null 2>&1; then EDITOR="vim"; fi
    if command -v vi >/dev/null 2>&1; then EDITOR="vi"; fi
  fi
}

open_source_file() {
  local file="$1" file_path status
  file_path="$(resolve_source_path "$file")"
  ensure_editor

  print_header "Opening $file_path in $EDITOR"
  set +e
  $EDITOR "$file_path"
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    printf '%bEditor exited with status %s.%b\n' "$COLOR_ERROR" "$status" "$COLOR_RESET" >&2
  fi
  return "$status"
}

run_edit() {
  local file="${1:-}" status

  if [[ -n "$file" ]]; then
    open_source_file "$file"
    return $?
  fi

  while true; do
    set +e
    file="$(select_source_file)"
    status=$?
    set -e
    if [[ "$status" -eq 130 ]]; then
      return 0
    elif [[ "$status" -ne 0 ]]; then
      return "$status"
    fi

    open_source_file "$file" || true
    echo ""
  done
}

if [[ -z "$cmd" ]]; then
  if [[ "$IS_TTY" -eq 0 ]]; then
    echo "Error: Not a TTY. Cannot open interactive menu. Use --help for direct commands." >&2
    exit 1
  fi

  while true; do
    selection=""
    if command -v gum >/dev/null 2>&1; then
      selection="$(menu_list | cut -f2 | gum choose "${GUM_CHOOSE_ARGS[@]}" --header="BQN-Ledger Command Hub (${base_dir})")"
      [[ -z "$selection" ]] && break
      key="$(menu_list | grep -F "$selection" | cut -f1)"
    elif command -v fzf >/dev/null 2>&1; then
      selection="$(menu_list | fzf --prompt='bl> ' --delimiter=$'\t' --with-nth=2.. --reverse --exit-0)"
      [[ -z "$selection" ]] && break
      key="${selection%%$'\t'*}"
    else
      echo "=== BQN-Ledger Command Hub ==="
      menu_list | awk -F'\t' '{print NR ") " $2 " (" $1 ")"}'
      printf "Select option: "
      read -r opt
      key="$(menu_list | sed -n "${opt}p" | cut -f1)"
      if [[ -z "$key" ]]; then
        key="$opt"
      fi
    fi

    case "$key" in
      report)
        print_header "Full Report"
        "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" report
        echo ""
        ;;
      section)
        "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" select
        echo ""
        ;;
      add)
        while true; do
          set +e
          "$ROOT_DIR/tools/add-ui.sh" --base "$base_dir"
          status=$?
          set -e
          if [[ "$status" -eq 130 ]]; then
            continue
          fi
          if [[ "$status" -ne 0 ]]; then
            printf '%bDaily write UI failed. Please review errors above.%b\n' "$COLOR_ERROR" "$COLOR_RESET"
          fi
          break
        done
        echo ""
        ;;
      browse)
        run_browse
        echo ""
        ;;
      check)
        run_source_check || true
        echo ""
        ;;
      doctor)
        run_doctor || true
        echo ""
        ;;
      inspect)
        run_inspect || true
        echo ""
        ;;
      export)
        run_export || true
        echo ""
        ;;
      edit)
        run_edit ""
        echo ""
        ;;
      dev-check)
        run_dev_check || true
        echo ""
        ;;
      exit)
        break
        ;;
      *)
        echo "Unknown option: $key"
        ;;
    esac
  done
else
  case "$cmd" in
    report|all)
      "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" report
      ;;
    section)
      section_key="${1:-}"
      if [[ -z "$section_key" ]]; then
        "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" select
      else
        "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" "$section_key"
      fi
      ;;
    add)
      if [[ $# -gt 0 ]]; then
        exec "$ROOT_DIR/tools/add-ui.sh" --base "$base_dir" "$@"
      fi
      while true; do
        set +e
        "$ROOT_DIR/tools/add-ui.sh" --base "$base_dir"
        status=$?
        set -e
        if [[ "$status" -eq 130 ]]; then
          continue
        fi
        exit "$status"
      done
      ;;
    browse)
      run_browse "${1:-}"
      ;;
    transactions)
      run_browse_surface transactions
      ;;
    plans)
      run_browse_surface plans
      ;;
    accounts)
      run_browse_surface accounts
      ;;
    issue-list)
      run_browse_surface issues
      ;;
    check)
      run_source_check
      ;;
    doctor)
      run_doctor
      ;;
    inspect)
      run_inspect
      ;;
    export)
      run_export
      ;;
    query)
      run_query "$@"
      ;;
    dev-check)
      run_dev_check
      ;;
    edit)
      run_edit "${1:-}"
      ;;
    *)
      if "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" "$cmd" >/dev/null 2>&1; then
        exec "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" "$cmd"
      else
        echo "Error: Unknown command or section '$cmd'" >&2
        usage >&2
        exit 1
      fi
      ;;
  esac
fi
