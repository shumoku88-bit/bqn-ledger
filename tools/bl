#!/usr/bin/env bash
set -euo pipefail

# tools/bl - canonical Household Command Hub.
# This script owns only navigation, selection, and presentation. Accounting,
# admission, and publication remain in the existing report/editor/tool owners.

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE == /* ]] || SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT_DIR"

source "$ROOT_DIR/tools/lib/system-defaults.sh"
source "$ROOT_DIR/tools/lib/theme.sh"
source "$ROOT_DIR/tools/lib/ui-preferences.sh"

usage() {
  cat <<'EOF'
Usage:
  tools/bl [--base DIR] [command [subcommand] [args...]]

Interactive Command Hub:
  Home             Read-only calendar observation above the interaction choices
  Editor           Structured Household changes
  Reports          Read-only semantic reports
  Source & System  Raw canonical sources, diagnostics, export, and maintenance

Direct commands (non-TTY safe when the target command is read-only):
  home [YYYY-MM-DD]              Home calendar for one focus month
  report, all                    Full current report
  section [KEY]                  Report selector or one retained report
  reports [KEY]                  Report selector or one retained report
  journal [list], transactions   Canonical transaction history
  plans list|all|overdue|upcoming [editor options]
  plans related [editor options] Related Plan evidence (interactive if no args)
  plans add|edit|finish          Existing selection-based writer UI
  accounts list [editor options] Canonical Account inventory
  accounts balances             Account Balances report
  accounts add                  Existing Account writer UI
  issues list                   Open Issue inventory
  issues report                 Issues report
  issues add|close              Existing Issue lifecycle UI
  record expense|income|transfer|multi|reverse
  budget add|envelopes
  check                          Strict canonical Household readiness
  inspect                        Canonical ledger/provenance inspection
  doctor                         Dependency and canonical-root diagnosis
  export                         Export canonical Journals for hledger
  query DOMAIN KEY [LATEST]      Exact compact-key query (advanced)
  dev-check                      Repository development suite (not Household check)
  edit [CANONICAL_FILE]          Open one of the eight canonical sources
  add                            Existing complete daily action menu

Direct command groups:
  operations    Household check, inspect, doctor, hledger export, source edit

Options:
  --base DIR                     Canonical eight-file Household root
  --domain COMMODITY             Explicit report domain
  --latest YYYY-MM-DD            Deterministic current-report / Home focus date
EOF
}

base_dir="${LEDGER_DATA_DIR:-$(get_default_base_dir)}"
domain_override="${REPORT_DOMAIN:-}"
latest_override=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base)
      [[ $# -ge 2 ]] || { echo 'Error: --base requires a directory' >&2; usage >&2; exit 2; }
      base_dir="$2"
      shift 2
      ;;
    --domain)
      [[ $# -ge 2 ]] || { echo 'Error: --domain requires a commodity' >&2; usage >&2; exit 2; }
      domain_override="$2"
      shift 2
      ;;
    --latest)
      [[ $# -ge 2 ]] || { echo 'Error: --latest requires YYYY-MM-DD' >&2; usage >&2; exit 2; }
      latest_override="$2"
      shift 2
      ;;
    -h|--help|help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "Error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done

IS_TTY=0
[[ -t 0 && -t 1 ]] && IS_TTY=1
COLOR_HEADER="$ESC_HEADER"
COLOR_OK="$ESC_OK"
COLOR_ERROR="$ESC_ERROR"
COLOR_RESET="$ESC_RESET"

print_header() { printf '%b=== %s ===%b\n' "$COLOR_HEADER" "$1" "$COLOR_RESET"; }

select_menu() {
  local prompt="$1" lines="$2" header="${3:-}" selector selection status=0 key='' label='' header_text=''
  selector="$(bl_selector_preference 2>/dev/null || echo auto)"
  if [[ "${BL_UI_MODE:-}" == minimal ]]; then
    selector=plain
  elif [[ $selector == auto ]]; then
    if command -v fzf >/dev/null 2>&1; then selector=fzf
    elif command -v gum >/dev/null 2>&1; then selector=gum
    else selector=plain
    fi
  fi

  if [[ $IS_TTY -eq 1 && $selector == fzf ]]; then
    local -a fzf_args=(--prompt="$prompt> " --delimiter=$'\t' --with-nth=2.. --reverse --exit-0)
    [[ -z $header ]] || fzf_args+=(--header="$header")
    set +e
    selection="$(printf '%s\n' "$lines" | fzf "${fzf_args[@]}")"
    status=$?
    set -e
    [[ $status -eq 0 && -n $selection ]] || return 130
    printf '%s\n' "${selection%%$'\t'*}"
  elif [[ $IS_TTY -eq 1 && $selector == gum ]]; then
    header_text="$prompt"
    [[ -z $header ]] || header_text="$header"$'\n\n'"$prompt"
    set +e
    selection="$(printf '%s\n' "$lines" | cut -f2- | gum choose "${GUM_CHOOSE_ARGS[@]}" --header="$header_text")"
    status=$?
    set -e
    [[ $status -eq 0 && -n $selection ]] || return 130
    key="$(awk -F'\t' -v label="$selection" '$0 ~ /^[^\t]+\t/ && substr($0,index($0,"\t")+1)==label {print $1; exit}' <<<"$lines")"
    [[ -n $key ]] || return 1
    printf '%s\n' "$key"
  else
    local -a keys=() labels=()
    local count=0 i answer
    while IFS=$'\t' read -r key label; do
      [[ -n $key ]] || continue
      keys+=("$key")
      labels+=("$label")
      count=$((count + 1))
    done <<<"$lines"
    [[ -z $header ]] || printf '\n%s\n' "$header" >&2
    printf '\n=== %s ===\n' "$prompt" >&2
    for ((i=0; i<count; i++)); do printf ' %2d) %s\n' "$((i+1))" "${labels[i]}" >&2; done
    printf '  0) Back\nSelect [0-%d]> ' "$count" >&2
    if [[ $IS_TTY -eq 1 ]]; then
      read -r answer </dev/tty || return 130
    else
      read -r answer || return 130
    fi
    [[ $answer != 0 && $answer != back && -n $answer ]] || return 130
    if [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= count)); then
      printf '%s\n' "${keys[answer-1]}"
      return 0
    fi
    for ((i=0; i<count; i++)); do
      [[ ${keys[i]} == "$answer" ]] && { printf '%s\n' "${keys[i]}"; return 0; }
    done
    return 1
  fi
}

run_child() {
  local status=0
  # Capture failure in conditional position so this helper never mutates the
  # caller's errexit state before returning status 130 (logical Back) or another
  # child status to the owning submenu.
  if "$@"; then
    return 0
  else
    status=$?
  fi
  if [[ $status -eq 130 ]]; then
    return 130
  elif [[ $status -ne 0 ]]; then
    printf '%bCommand failed with status %s.%b\n' "$COLOR_ERROR" "$status" "$COLOR_RESET" >&2
  fi
  return "$status"
}

home_focus_date() {
  if [[ -n $latest_override ]]; then
    printf '%s\n' "$latest_override"
  else
    date +%Y-%m-%d
  fi
}

run_home() {
  local focus="${1:-}"
  [[ -n $focus ]] || focus="$(home_focus_date)"
  run_child "$ROOT_DIR/tools/home-calendar" "$base_dir" "$focus"
}

home_header() {
  local focus output status=0
  focus="$(home_focus_date)"
  set +e
  output="$("$ROOT_DIR/tools/home-calendar" "$base_dir" "$focus" 2>&1)"
  status=$?
  set -e
  if [[ $status -eq 0 ]]; then
    printf '%s\n' "$output"
  else
    printf '[Home unavailable for %s]\n%s\n' "$focus" "$output"
  fi
}

run_action() {
  local mode="$1"
  if [[ -n $mode ]]; then
    run_child "$ROOT_DIR/tools/add-ui.sh" --base "$base_dir" "$mode"
  else
    run_child "$ROOT_DIR/tools/add-ui.sh" --base "$base_dir"
  fi
}

run_check() {
  print_header 'Canonical Household Check'
  if "$ROOT_DIR/tools/ledger-check" "$base_dir"; then
    printf '%bCanonical Household is ready.%b\n' "$COLOR_OK" "$COLOR_RESET"
  else
    local status=$?
    printf '%bCanonical Household admission failed.%b\n' "$COLOR_ERROR" "$COLOR_RESET" >&2
    return "$status"
  fi
}

canonical_files() {
  cat <<'EOF'
accounts.journal	Account declarations
actual.journal	Actual transactions
plan.journal	Future Plans
budget.journal	Budget movements
budget.toml	Budget policy
household.toml	Household policy
report.toml	Report policy
issues.tsv	Issues and decisions
EOF
}

resolve_source_path() {
  case "$1" in
    accounts.journal|actual.journal|plan.journal|budget.journal|budget.toml|household.toml|report.toml|issues.tsv)
      printf '%s/%s\n' "$base_dir" "$1" ;;
    *) return 2 ;;
  esac
}

open_source() {
  local file="$1" path editor status=0
  if ! path="$(resolve_source_path "$file")"; then
    echo "Error: source edit is limited to the canonical eight files: $file" >&2
    return 2
  fi
  editor="${EDITOR:-}"
  if [[ -z $editor ]]; then
    editor=nano
    command -v vim >/dev/null 2>&1 && editor=vim
    command -v vi >/dev/null 2>&1 && editor=vi
  fi
  print_header "Opening $path in $editor"
  set +e
  $editor "$path"
  status=$?
  set -e
  return "$status"
}

run_edit_menu() {
  local file="${1:-}" key status
  [[ -z $file ]] || { open_source "$file"; return; }
  [[ $IS_TTY -eq 1 ]] || {
    canonical_files >&2
    echo 'Error: edit without a file requires an interactive terminal' >&2
    return 2
  }
  while true; do
    set +e
    key="$(select_menu 'Open canonical source' "$(canonical_files)")"
    status=$?
    set -e
    [[ $status -eq 130 ]] && return 0
    [[ $status -eq 0 ]] || return "$status"
    open_source "$key" || true
  done
}

report_lines() {
  printf 'preview\t★ プレビュー閲覧 (矢印キー [←/→] で連続プレビュー)\n'
  printf 'all\tAll twelve reports\n'
  "$ROOT_DIR/tools/report-section-metadata" | awk -F'\t' 'NR>1 {print $1 "\t" $2}'
  printf 'back\tBack\n'
}

select_reports_menu() {
  local prompt="$1" lines="$2" selector selection status=0 key='' label='' cache_dir=''
  selector="$(bl_selector_preference 2>/dev/null || echo auto)"
  if [[ "${BL_UI_MODE:-}" == minimal ]]; then
    selector=plain
  elif [[ $selector == auto ]]; then
    if command -v fzf >/dev/null 2>&1; then selector=fzf
    elif command -v gum >/dev/null 2>&1; then selector=gum
    else selector=plain
    fi
  fi

  if [[ $IS_TTY -eq 1 && $selector == fzf ]]; then
    cache_dir="$(run_child "$ROOT_DIR/tools/main-ui.sh" --base "$base_dir" prepare-cache 2>/dev/null || true)"
    local preview_win
    preview_win="$(bl_fzf_preview_window 2>/dev/null || echo 'right:50%')"
    set +e
    if [[ -n $cache_dir && -d $cache_dir ]]; then
      selection="$(printf '%s\n' "$lines" | fzf --prompt="$prompt> " --delimiter=$'\t' --with-nth=2.. --height=80% --reverse --exit-0 --ansi \
        --preview "BL_THEME='${BL_THEME:-nord}' COLOR_FORCE=1 '$ROOT_DIR/tools/command-hub-preview' '$cache_dir' {1} | BL_THEME='${BL_THEME:-nord}' COLOR_FORCE=1 REPORT_NEGATIVE_COLOR='${report_negative_color:-red}' '$ROOT_DIR/tools/lib/color-filter'" \
        --preview-window "$preview_win")"
    else
      selection="$(printf '%s\n' "$lines" | fzf --prompt="$prompt> " --delimiter=$'\t' --with-nth=2.. --reverse --exit-0)"
    fi
    status=$?
    set -e
    [[ $status -eq 0 && -n $selection ]] || return 130
    printf '%s\n' "${selection%%$'\t'*}"
  else
    select_menu "$prompt" "$lines"
  fi
}

run_reports() {
  local key="${1:-}" status
  if [[ -z $key ]]; then
    [[ $IS_TTY -eq 1 ]] || { echo 'Error: reports requires KEY outside an interactive terminal' >&2; return 2; }
    while true; do
      set +e
      key="$(select_reports_menu 'Reports' "$(report_lines)")"
      status=$?
      set -e
      [[ $status -eq 130 ]] && return 0
      [[ $status -eq 0 ]] || return "$status"
      [[ $key == back ]] && return 0
      run_reports "$key" || true
      [[ $IS_TTY -eq 1 ]] && printf '\n'
    done
    return 0
  fi
  local -a ui_args=(--base "$base_dir")
  [[ -z $domain_override ]] || ui_args+=(--domain "$domain_override")
  [[ -z $latest_override ]] || ui_args+=(--latest "$latest_override")
  if [[ $key == preview || $key == browse ]]; then
    run_child "$ROOT_DIR/tools/main-ui.sh" "${ui_args[@]}" preview
  elif [[ $key == all || $key == report ]]; then
    run_child "$ROOT_DIR/tools/main-ui.sh" "${ui_args[@]}" report
  else
    run_child "$ROOT_DIR/tools/main-ui.sh" "${ui_args[@]}" "$key"
  fi
}

report_group_menu() {
  cat <<'EOF'
household	Household
accounting	Accounting
operations	Activity
all	All reports
preview	Sequential preview
back	Back
EOF
}

report_group_lines() {
  local category="$1"
  "$ROOT_DIR/tools/report-section-metadata" |
    awk -F'\t' -v category="$category" 'NR>1 && $3==category {print $1 "\t" $2}'
  printf 'back\tBack\n'
}

run_report_group() {
  local category="$1" title="$2" key status
  while true; do
    set +e
    key="$(select_reports_menu "$title" "$(report_group_lines "$category")")"
    status=$?
    set -e
    [[ $status -eq 130 ]] && return 0
    [[ $status -eq 0 ]] || return "$status"
    [[ $key == back ]] && return 0
    run_reports "$key" || true
    [[ $IS_TTY -eq 1 ]] && printf '\n'
  done
}

run_reports_hub() {
  local key status
  while true; do
    set +e
    key="$(select_menu 'Reports' "$(report_group_menu)")"
    status=$?
    set -e
    [[ $status -eq 130 ]] && return 0
    [[ $status -eq 0 ]] || { echo 'Invalid selection.' >&2; continue; }
    case "$key" in
      household) run_report_group household Household ;;
      accounting) run_report_group accounting Accounting ;;
      operations) run_report_group operations Activity ;;
      all) run_reports all || true ;;
      preview) run_reports preview || true ;;
      back) return 0 ;;
    esac
    [[ $IS_TTY -eq 1 ]] && printf '\n'
  done
}

show_plan_related_interactive() {
  local rows selected status index selected_row selected_plan_date
  rows="$("$ROOT_DIR/tools/edit" --base "$base_dir" plan list --format tsv)"
  [[ -n $rows ]] || { echo 'No open Plans.'; return 0; }
  set +e
  selected="$(select_menu 'Plan for related evidence' "$(awk -F'\t' '{print $1 "\t" $9}' <<<"$rows")")"
  status=$?
  set -e
  [[ $status -eq 130 ]] && return 130
  [[ $status -eq 0 ]] || return "$status"
  index="$selected"
  selected_row="$(awk -F'\t' -v selected_index="$index" '$1==selected_index {print; found++} END {if (found!=1) exit 1}' <<<"$rows")" || {
    echo 'Failed to resolve the selected Plan row.' >&2
    return 1
  }
  selected_plan_date="$(cut -f3 <<<"$selected_row")"
  run_child "$ROOT_DIR/tools/edit" --base "$base_dir" plan related --index "$index" --actual-date "$selected_plan_date" --format tsv
}

prompt_value() {
  local prompt="$1" default="${2:-}" value
  if [[ -n $default ]]; then printf '%s [%s]: ' "$prompt" "$default" >&2; else printf '%s: ' "$prompt" >&2; fi
  read -r value </dev/tty || return 130
  [[ -n $value ]] || value="$default"
  [[ -n $value ]] || return 130
  printf '%s\n' "$value"
}

run_summary_interactive() {
  local domain
  domain="$(prompt_value 'Commodity' "$domain_override")" || return 130
  if [[ -n $latest_override ]]; then
    "$ROOT_DIR/tools/report-summary" "$base_dir" "$domain" "$latest_override"
  else
    "$ROOT_DIR/tools/report-summary" "$base_dir" "$domain"
  fi
}

run_query_interactive() {
  local domain keys key status
  domain="$(prompt_value 'Commodity' "$domain_override")" || return 130
  if [[ -n $latest_override ]]; then
    keys="$("$ROOT_DIR/tools/query" "$base_dir" "$domain" --keys "$latest_override")"
  else
    keys="$("$ROOT_DIR/tools/query" "$base_dir" "$domain" --keys)"
  fi
  set +e
  key="$(select_menu 'Compact key' "$(awk '{print $0 "\t" $0}' <<<"$keys")")"
  status=$?
  set -e
  [[ $status -eq 130 ]] && return 130
  [[ $status -eq 0 ]] || return "$status"
  if [[ -n $latest_override ]]; then
    "$ROOT_DIR/tools/query" "$base_dir" "$domain" "$key" "$latest_override"
  else
    "$ROOT_DIR/tools/query" "$base_dir" "$domain" "$key"
  fi
}

# Direct-command handlers remain stable even though the interactive Hub is
# grouped by interaction type.
run_record_key() {
  case "$1" in
    expense|income|move|multi|reverse) run_action "$1" ;;
    transfer) run_action move ;;
    history|list) "$ROOT_DIR/tools/edit" --base "$base_dir" journal list ;;
    back) return 130 ;;
    *) echo "Error: unknown record action: $1" >&2; return 2 ;;
  esac
}

run_plan_key() {
  local key="$1"; shift
  case "$key" in
    list) "$ROOT_DIR/tools/edit" --base "$base_dir" plan list "$@" ;;
    all) "$ROOT_DIR/tools/edit" --base "$base_dir" plan list --all "$@" ;;
    overdue|upcoming)
      "$ROOT_DIR/tools/edit" --base "$base_dir" plan list --temporal "$key" --as-of "$(date +%Y-%m-%d)" "$@" ;;
    related)
      if [[ $# -gt 0 ]]; then "$ROOT_DIR/tools/edit" --base "$base_dir" plan related "$@"; else show_plan_related_interactive; fi ;;
    add) run_action plan-add ;;
    edit) run_action plan-edit ;;
    finish) run_action plan-finish ;;
    back) return 130 ;;
    *) echo "Error: unknown Plans action: $key" >&2; return 2 ;;
  esac
}

run_budget_key() {
  case "$1" in
    add|move) run_action budget ;;
    report|envelopes) run_reports envelopes ;;
    back) return 130 ;;
    *) echo "Error: unknown Budget action: $1" >&2; return 2 ;;
  esac
}

run_account_key() {
  local key="$1"; shift
  case "$key" in
    list) "$ROOT_DIR/tools/edit" --base "$base_dir" account list "$@" ;;
    balances) run_reports balances ;;
    add) run_action account-add ;;
    back) return 130 ;;
    *) echo "Error: unknown Accounts action: $key" >&2; return 2 ;;
  esac
}

run_issue_key() {
  case "$1" in
    list) "$ROOT_DIR/tools/edit" --base "$base_dir" issue list ;;
    report) run_reports issues ;;
    add) run_action issue ;;
    close) run_action issue-close ;;
    back) return 130 ;;
    *) echo "Error: unknown Issues action: $1" >&2; return 2 ;;
  esac
}

run_operation_key() {
  local key="$1"; shift
  case "$key" in
    check) run_check ;;
    inspect) "$ROOT_DIR/tools/ledger-inspect" "$base_dir" ;;
    doctor) LEDGER_DATA_DIR="$base_dir" "$ROOT_DIR/tools/doctor" ;;
    export) "$ROOT_DIR/tools/to-hledger" "$base_dir" ;;
    edit|open-source) run_edit_menu "${1:-}" ;;
    summary)
      if [[ $# -gt 0 ]]; then "$ROOT_DIR/tools/report-summary" "$base_dir" "$@"; elif [[ $IS_TTY -eq 1 ]]; then run_summary_interactive; else echo 'Error: operations summary requires DOMAIN' >&2; return 2; fi ;;
    query)
      if [[ $# -gt 1 ]]; then "$ROOT_DIR/tools/query" "$base_dir" "$@"; elif [[ $IS_TTY -eq 1 ]]; then run_query_interactive; else echo 'Error: operations query requires DOMAIN LEDGER_KEY' >&2; return 2; fi ;;
    dev-check) "$ROOT_DIR/tools/check.sh" ;;
    back) return 130 ;;
    *) echo "Error: unknown operation: $key" >&2; return 2 ;;
  esac
}

