run_interactive_submenu() {
  local title="$1" list_fn="$2" handler="$3" key status
  while true; do
    set +e
    key="$(select_menu "$title" "$("$list_fn")")"
    status=$?
    set -e
    [[ $status -eq 130 ]] && return 0
    [[ $status -eq 0 ]] || { echo 'Invalid selection.' >&2; continue; }
    [[ $key == back ]] && return 0
    set +e
    "$handler" "$key"
    status=$?
    set -e
    [[ $status -eq 130 ]] || [[ $status -eq 0 ]] || true
    [[ $IS_TTY -eq 1 ]] && printf '\n'
  done
}

run_editor_key() {
  case "$1" in
    journal) run_interactive_submenu Journal editor_journal_menu run_record_key ;;
    plans) run_interactive_submenu Plans editor_plans_menu run_plan_key ;;
    budget) run_interactive_submenu Budget editor_budget_menu run_budget_key ;;
    accounts) run_interactive_submenu Accounts editor_accounts_menu run_account_key ;;
    issues) run_interactive_submenu Issues editor_issues_menu run_issue_key ;;
    back) return 130 ;;
    *) echo "Error: unknown Editor area: $1" >&2; return 2 ;;
  esac
}

run_editor_hub() {
  run_interactive_submenu Editor editor_menu run_editor_key
}

run_source_system_hub() {
  run_interactive_submenu 'Source & System' source_system_menu run_operation_key
}

run_interactive_hub() {
  local key status home
  [[ $IS_TTY -eq 1 ]] || { echo 'Error: no command and no interactive terminal; use tools/bl --help' >&2; return 2; }
  # Keep the navigation shell alive while the active selector/child receives
  # Ctrl-C. External children reset this caught signal to their normal default.
  trap ':' INT
  while true; do
    home="$(home_header)"
    set +e
    key="$(select_menu "BQN-Ledger Command Hub ($base_dir)" "$(top_menu)" "$home")"
    status=$?
    set -e
    [[ $status -eq 130 ]] && return 0
    [[ $status -eq 0 ]] || { echo 'Invalid selection.' >&2; continue; }
    case "$key" in
      editor) run_editor_hub ;;
      reports) run_reports_hub ;;
      source-system) run_source_system_hub ;;
      exit) return 0 ;;
    esac
  done
}

if [[ $# -eq 0 ]]; then
  run_interactive_hub
  exit $?
fi

cmd="$1"; shift
case "$cmd" in
  home) run_home "${1:-}" ;;
  report|all) run_reports all ;;
  section|reports)
    if [[ $# -gt 0 ]]; then run_reports "$1"; else run_reports; fi ;;
  journal)
    sub="${1:-list}"; [[ $# -eq 0 ]] || shift
    case "$sub" in list|history) "$ROOT_DIR/tools/edit" --base "$base_dir" journal list "$@" ;; *) echo "Error: unknown journal action: $sub" >&2; exit 2 ;; esac ;;
  transactions) "$ROOT_DIR/tools/edit" --base "$base_dir" journal list ;;
  browse)
    [[ $# -gt 0 ]] || { echo 'Error: browse requires transactions|plans|accounts|issues' >&2; exit 2; }
    case "$1" in
      transactions|journal) "$ROOT_DIR/tools/edit" --base "$base_dir" journal list ;;
      plans) "$ROOT_DIR/tools/edit" --base "$base_dir" plan list ;;
      accounts) "$ROOT_DIR/tools/edit" --base "$base_dir" account list ;;
      issues) "$ROOT_DIR/tools/edit" --base "$base_dir" issue list ;;
      *) echo "Error: unknown browse surface: $1" >&2; exit 2 ;;
    esac ;;
  record)
    [[ $# -gt 0 ]] || { echo 'Error: record requires an action' >&2; exit 2; }
    run_record_key "$1" ;;
  plans|plan)
    if [[ $# -eq 0 ]]; then "$ROOT_DIR/tools/edit" --base "$base_dir" plan list; else sub="$1"; shift; run_plan_key "$sub" "$@"; fi ;;
  budget)
    [[ $# -gt 0 ]] || { echo 'Error: budget requires an action' >&2; exit 2; }
    run_budget_key "$1" ;;
  accounts|account)
    if [[ $# -eq 0 ]]; then "$ROOT_DIR/tools/edit" --base "$base_dir" account list; else sub="$1"; shift; run_account_key "$sub" "$@"; fi ;;
  issues|issue)
    [[ $# -gt 0 ]] || { echo 'Error: issues requires an action' >&2; exit 2; }
    run_issue_key "$1" ;;
  issue-list) "$ROOT_DIR/tools/edit" --base "$base_dir" issue list ;;
  operations|operation)
    [[ $# -gt 0 ]] || { echo 'Error: operations requires an action' >&2; exit 2; }
    sub="$1"; shift; run_operation_key "$sub" "$@" ;;
  check) run_check ;;
  inspect) run_operation_key inspect ;;
  doctor) run_operation_key doctor ;;
  export|to-hledger) run_operation_key export ;;
  query) run_operation_key query "$@" ;;
  summary) run_operation_key summary "$@" ;;
  dev-check) run_operation_key dev-check ;;
  edit) run_edit_menu "${1:-}" ;;
  add) run_action "${1:-}" ;;
  expense|income|move|transfer|multi|reverse) run_record_key "$cmd" ;;
  *)
    # Retained report keys stay source-owned by the report catalog. This fallback
    # asks main-ui to validate and route the key; no legacy aliases are added.
    run_reports "$cmd" ;;
esac
