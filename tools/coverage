#!/usr/bin/env bash
set -euo pipefail

# tools/coverage — qualification inventory, not line/module code coverage.
#
# BQN owners are often exercised through public shell/application paths, so a
# hand-maintained module -> check table becomes stale and cannot honestly label a
# module "untested". This tool reports repository inventory and direct evidence
# references only; tools/check.sh remains the qualification authority.

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

cd "$ROOT_DIR"
shopt -s nullglob

destination_modules=(
  src/ledger/*.bqn src/accounting/*.bqn src/sections/*.bqn src/report/*.bqn
  src/application/*.bqn src/editor/*.bqn src/text/*.bqn
)
destination_tests=(
  tests/test_ledger_*.bqn tests/test_accounting_*.bqn tests/test_section_*.bqn
  tests/test_report_*.bqn tests/test_application_*.bqn tests/test_editor_*.bqn
  tests/test_text_*.bqn
)
src_edit_modules=(src_edit/*.bqn)
bqn_tests=(tests/test_*.bqn)
shell_checks=(checks/check-*.sh)

printf '=== qualification inventory ===\n'
printf '  production BQN modules: %s\n' "$(( ${#destination_modules[@]} + ${#src_edit_modules[@]} ))"
printf '  BQN test files auto-run by tools/check.sh: %s\n' "${#bqn_tests[@]}"
printf '  shell check files present: %s\n' "${#shell_checks[@]}"
printf '\n'

printf '=== destination owner test inventory ===\n'
printf '  destination modules: %s\n' "${#destination_modules[@]}"
printf '  matching owner-oriented test files: %s\n' "${#destination_tests[@]}"
for test_file in "${destination_tests[@]}"; do
  printf '    %s\n' "$(basename "$test_file")"
done
printf '\n'

printf '=== src_edit direct evidence references ===\n'
printf '  note: no direct reference does not mean unqualified; many command owners are exercised through tools/edit[-bqn].\n'
for mod in "${src_edit_modules[@]}"; do
  name="$(basename "$mod")"
  mapfile -t refs < <(rg -l -F "src_edit/$name" tests checks 2>/dev/null | sort || true)
  if ((${#refs[@]} > 0)); then
    printf '  direct: %s <- %s\n' "$name" "${refs[*]}"
  else
    printf '  transitive/no-direct-reference: %s\n' "$name"
  fi
done
printf '\n'

printf '=== shell check reachability from tools/check.sh ===\n'
for check in "${shell_checks[@]}"; do
  name="$(basename "$check")"
  if grep -Fq "$name" tools/check.sh; then
    printf '  direct-full-suite: %s\n' "$name"
  else
    printf '  runner-external-or-transitive: %s\n' "$name"
  fi
done

printf '\nQualification authority: tools/check.sh\n'
