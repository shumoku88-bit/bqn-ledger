#!/usr/bin/env bash
# Stage, validate, and publish one complete destination human cache generation.
set -euo pipefail
if [[ $# -ne 4 ]]; then
  printf 'Usage: tools/report-destination-cache BASE CACHE_DIR GENERATION_TOKEN REQUEST_MANIFEST\n' >&2
  exit 2
fi
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
cache_dir=$2
generation=$3
manifest_name=$4
[[ $base == /* ]] || base="$caller_pwd/$base"
[[ $cache_dir == /* ]] || cache_dir="$caller_pwd/$cache_dir"
[[ $generation =~ ^[0-9]+$ ]] || { printf 'ERROR\tcache_generation_invalid\tgeneration token must be decimal digits\n' >&2; exit 1; }
[[ $manifest_name != */* && $manifest_name != *\\* && $manifest_name == *.tsv ]] \
  || { printf 'ERROR\tall_manifest_basename_invalid\tmanifest must be a safe .tsv basename\n' >&2; exit 1; }
manifest="$base/$manifest_name"
[[ -f $manifest && -r $manifest ]] \
  || { printf 'ERROR\tall_manifest_unreadable\tmanifest is not readable\n' >&2; exit 1; }
mkdir -p "$cache_dir"
lock="$cache_dir/.destination-cache-lock"
if ! mkdir "$lock" 2>/dev/null; then
  lock_pid=$(cat "$lock/pid" 2>/dev/null || true)
  if [[ $lock_pid =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
    printf 'ERROR\tcache_refresh_locked\tanother destination cache refresh is running\n' >&2
    exit 1
  fi
  rm -rf "$lock"
  mkdir "$lock" || { printf 'ERROR\tcache_lock_failed\tcache lock cannot be acquired\n' >&2; exit 1; }
fi
printf '%s\n' "$$" >"$lock/pid"
stage=$(mktemp -d "$cache_dir/.destination-stage.XXXXXX")
cleanup() { rm -rf "$stage" "$lock"; }
trap cleanup EXIT

selection="$(bqn "$root/src/application/report_selection_cli.bqn" all human)"
mapfile -t expected_keys <<<"$selection"
mapfile -t lines <"$manifest"
[[ ${lines[0]:-} == $'key\tsurface\targuments' ]] \
  || { printf 'ERROR\tall_manifest_header_invalid\tmanifest header is not exact\n' >&2; exit 1; }
rows=("${lines[@]:1}")
[[ ${#rows[@]} -eq ${#expected_keys[@]} ]] \
  || { printf 'ERROR\tall_manifest_count_mismatch\tmanifest must contain every human key\n' >&2; exit 1; }

for index in "${!expected_keys[@]}"; do
  IFS=$'\t' read -r -a fields <<<"${rows[$index]}"
  [[ ${#fields[@]} -ge 3 ]] \
    || { printf 'ERROR\tall_manifest_row_invalid\tmanifest row is incomplete\n' >&2; exit 1; }
  [[ ${fields[0]} == "${expected_keys[$index]}" && ${fields[1]} == human ]] \
    || { printf 'ERROR\tall_manifest_order_mismatch\tmanifest must use catalog human order\n' >&2; exit 1; }
done

: >"$stage/all.txt"
for index in "${!expected_keys[@]}"; do
  IFS=$'\t' read -r -a fields <<<"${rows[$index]}"
  key=${expected_keys[$index]}
  "$root/tools/report-destination" "$base" "${fields[@]}" >"$stage/$key.txt"
  cat "$stage/$key.txt" >>"$stage/all.txt"
done
printf '%s\n' "${expected_keys[@]}" all >"$stage/.section-keys"
[[ -s $stage/all.txt ]] || { printf 'ERROR\tcache_all_empty\tall cache body is empty\n' >&2; exit 1; }
for key in "${expected_keys[@]}" all; do
  [[ -f $stage/$key.txt ]] || { printf 'ERROR\tcache_body_missing\tmissing cache body: %s\n' "$key" >&2; exit 1; }
done

# Publish bodies and canonical manifest by atomic rename. Timestamp is the commit marker.
for key in "${expected_keys[@]}" all; do
  mv -f "$stage/$key.txt" "$cache_dir/$key.txt"
done
mv -f "$stage/.section-keys" "$cache_dir/.section-keys"
for stale in "$cache_dir"/*.txt; do
  [[ -e $stale ]] || continue
  name=${stale##*/}
  key=${name%.txt}
  keep=0
  for expected in "${expected_keys[@]}" all; do [[ $key == "$expected" ]] && keep=1; done
  [[ $keep -eq 1 ]] || rm -f "$stale"
done
timestamp=$(mktemp "$cache_dir/.cache-timestamp.XXXXXX")
printf '%s\n' "$generation" >"$timestamp"
mv -f "$timestamp" "$cache_dir/.cache-timestamp"
