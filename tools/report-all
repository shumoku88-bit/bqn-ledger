#!/usr/bin/env bash
# Run the selected all-report surface from canonical report.toml plus typed
# canonical Household evidence. No request-manifest file is an execution input.
set -euo pipefail
if [[ $# -lt 3 || $# -gt 4 ]]; then
  printf 'Usage: tools/report-all BASE DOMAIN SURFACE [LATEST]\n' >&2
  exit 2
fi
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
caller_pwd=$PWD
base=$1
domain=$2
surface=$3
latest=${4:-}
[[ $base == /* ]] || base="$caller_pwd/$base"
cd "$root"

request_args=("$base" "$domain" "$surface")
[[ -z $latest ]] || request_args+=("$latest")
request_set=""
if ! request_set="$(bqn src/application/current_report_profile_cli.bqn "${request_args[@]}" 2>&1)"; then
  printf '%s\n' "$request_set" >&2
  exit 1
fi
mapfile -t rows <<<"$request_set"
[[ ${rows[0]:-} == $'key\tsurface\targuments' ]] || {
  printf 'ERROR\tcurrent_request_header_invalid\tcurrent request set header is invalid\n' >&2
  exit 1
}

output=$(mktemp "${TMPDIR:-/tmp}/bqn-ledger-all.XXXXXX")
trap 'rm -f "$output"' EXIT
for row in "${rows[@]:1}"; do
  IFS=$'\t' read -r -a fields <<<"$row"
  [[ ${#fields[@]} -ge 2 ]] || {
    printf 'ERROR\tcurrent_request_row_invalid\tcurrent request row is incomplete\n' >&2
    exit 1
  }
  [[ ${fields[1]} == "$surface" ]] || {
    printf 'ERROR\tcurrent_request_surface_mismatch\tcurrent request row surface differs from selection\n' >&2
    exit 1
  }
  "$root/tools/report" "$base" "${fields[@]}" >>"$output"
done
cat "$output"
