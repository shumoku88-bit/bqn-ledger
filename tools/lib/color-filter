#!/usr/bin/env bash
# tools/lib/color-filter — Add terminal ANSI colors to plain text ledger reports.
# Read stdin, write colored text to stdout.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Initialize theme (which exports ESC_* variables)
source "$SCRIPT_DIR/theme.sh"

# If output is not a TTY or theme is plain, don't colorize (unless forced via COLOR_FORCE/CLICOLOR_FORCE/FORCE_COLOR)
force="${COLOR_FORCE:-${CLICOLOR_FORCE:-${FORCE_COLOR:-}}}"
if [[ -z "$force" && ! -t 1 ]] || [[ "$BL_THEME" == "plain" ]]; then
  exec cat
fi

# Single-pass AWK filter for fast, collision-safe ANSI colorizing
exec awk \
  -v h="$ESC_HEADER" \
  -v ok="$ESC_OK" \
  -v warn="$ESC_WARN" \
  -v err="$ESC_ERROR" \
  -v fut="$ESC_FUTURE" \
  -v mut="$ESC_MUTED" \
  -v num="$ESC_NUM_HEADER" \
  -v r="$ESC_RESET" '
BEGIN {
  # Word replacement map
  kw["completed"] = ok "completed" r
  kw["paid"]      = ok "paid" r
  kw["future"]    = fut "future" r
  kw["due"]       = warn "due" r
  kw["overdue"]   = err "overdue" r
  kw["PASS"]      = ok "PASS" r
  kw["FAIL"]      = err "FAIL" r
  kw["Balanced: YES"] = ok "Balanced: YES" r
  kw["Balanced: NO"]  = err "Balanced: NO" r

  # Account prefix map
  pfx["assets:"]      = h "assets:" r
  pfx["liabilities:"] = warn "liabilities:" r
  pfx["equity:"]      = fut "equity:" r
  pfx["income:"]      = ok "income:" r
  pfx["expenses:"]    = warn "expenses:" r
}

{
  line = $0

  # 1. Full-line header / divider patterns
  if (line ~ /^== .* ==$/) {
    sub(/^== /, h "== ", line)
    sub(/ ==$/, " ==" r, line)
    print line
    next
  }
  if (line ~ /^── .* ──$/) {
    sub(/^── /, mut "── ", line)
    sub(/ ──$/, " ──" r, line)
    print line
    next
  }
  if (line ~ /^[0-9]{1,2}\. /) {
    line = num line r
    print line
    next
  }
  if (line ~ /^[-+|]{4,}$/) {
    line = mut line r
    print line
    next
  }

  # 2. Key phrases and account prefixes
  for (k in kw) {
    gsub(k, kw[k], line)
  }

  # 3. Totals vs Account Prefixes
  if (line ~ /^Total [^|]*/) {
    match(line, /^Total [^|]*/)
    tot = substr(line, RSTART, RLENGTH)
    sub(/^Total [^|]*/, h tot r, line)
  } else {
    for (p in pfx) {
      if (index(line, p) == 1) {
        sub("^" p, pfx[p], line)
      } else if (index(line, " " p) > 0) {
        sub(" " p, " " pfx[p], line)
      }
    }
  }

  # 4. Numeric values (Negative and Positive)
  # Negative numbers after space or |
  while (match(line, /([[:space:]|])(-[0-9]+)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/-[0-9]+/, err "&" r, matched)
    line = prefix matched rest
  }

  # Positive signed numbers
  while (match(line, /([[:space:]|])(\+[0-9]+)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/\+[0-9]+/, ok "&" r, matched)
    line = prefix matched rest
  }

  # Positive table values after |
  while (match(line, /(\|[[:space:]]*)([1-9][0-9]*)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/[1-9][0-9]*/, ok "&" r, matched)
    line = prefix matched rest
  }

  print line
}
'
