#!/usr/bin/env bash
# tools/lib/color-filter — Add terminal ANSI colors to plain text ledger reports.
# Read stdin, write colored text to stdout.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Initialize theme (which exports ESC_* variables)
source "$SCRIPT_DIR/theme.sh"

# If output is not a TTY or theme is plain, don't colorize (unless forced via COLOR_FORCE/CLICOLOR_FORCE/FORCE_COLOR)
force="${COLOR_FORCE:-${CLICOLOR_FORCE:-${FORCE_COLOR:-}}}"
if [[ -z "$force" && ! -t 1 ]] || [[ "$BL_THEME" == "plain" ]]; then
  exec cat
fi

negative_color="$ESC_ERROR"
case "${REPORT_NEGATIVE_COLOR:-}" in
  '') ;;
  red) negative_color=$'\e[31m' ;;
  bright-red) negative_color=$'\e[91m' ;;
  green) negative_color=$'\e[32m' ;;
  yellow) negative_color=$'\e[33m' ;;
  blue) negative_color=$'\e[34m' ;;
  magenta) negative_color=$'\e[35m' ;;
  cyan) negative_color=$'\e[36m' ;;
  white) negative_color=$'\e[37m' ;;
  *) printf 'ERROR\treport_negative_color_invalid\tunsupported Report negative color: %s\n' "$REPORT_NEGATIVE_COLOR" >&2; exit 1 ;;
esac

# Single-pass AWK filter: Highlighting only Headers, Dividers, and Numbers
exec awk \
  -v h="$ESC_HEADER" \
  -v ok="$ESC_OK" \
  -v err="$negative_color" \
  -v mut="$ESC_MUTED" \
  -v num="$ESC_NUM_HEADER" \
  -v r="$ESC_RESET" '
{
  line = $0

  # 1. Full-line section headers and table dividers
  if (line ~ /^== .* ==$/) {
    sub(/^== /, h "== ", line)
    sub(/ ==$/, " ==" r, line)
    print line
    next
  }
  if (line ~ /^── .* ──$/) {
    sub(/^── /, mut "── ", line)
    sub(/ ──$/, " ──" r, line)
    print line
    next
  }
  if (line ~ /^[0-9]{1,2}\. /) {
    line = num line r
    print line
    next
  }
  if (line ~ /^[-+|]{4,}$/) {
    line = mut line r
    print line
    next
  }

  # 2. Section totals highlighting
  if (line ~ /^Total [^|]*/) {
    match(line, /^Total [^|]*/)
    tot = substr(line, RSTART, RLENGTH)
    sub(/^Total [^|]*/, h tot r, line)
  }

  # 3. Numeric values (Negative and Positive numbers)
  # Negative numbers after space or |
  while (match(line, /([[:space:]|])(-[0-9]+)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/-[0-9]+/, err "&" r, matched)
    line = prefix matched rest
  }

  # Parenthesized negative notation after canonical presentation filtering.
  while (match(line, /([[:space:]|])(\([0-9]+([.][0-9]+)?\))/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/\([0-9]+([.][0-9]+)?\)/, err "&" r, matched)
    line = prefix matched rest
  }

  # Positive signed numbers
  while (match(line, /([[:space:]|])(\+[0-9]+)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/\+[0-9]+/, ok "&" r, matched)
    line = prefix matched rest
  }

  # Positive table values after |
  while (match(line, /(\|[[:space:]]*)([1-9][0-9]*)/)) {
    prefix = substr(line, 1, RSTART - 1)
    matched = substr(line, RSTART, RLENGTH)
    rest = substr(line, RSTART + RLENGTH)
    sub(/[1-9][0-9]*/, ok "&" r, matched)
    line = prefix matched rest
  }

  print line
}
'
